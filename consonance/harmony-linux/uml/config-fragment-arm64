# arm64 overlay merged after config-fragment. The RFC port defaults to 16 KiB
# pages, and the Harmony device maps its request and response frames as
# separate 4 KiB pages. A guest page is a host mapping, so the host must use
# 4 KiB pages too.
CONFIG_PAGE_SIZE_4KB=y
# CONFIG_PAGE_SIZE_16KB is not set
# CONFIG_PAGE_SIZE_64KB is not set
