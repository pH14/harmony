# User-mode Linux overlay merged last over ARCH=um defconfig. It keeps the
# guest on one CPU with periodic ticks and time-travel time, links the
# executable statically so the host library closure is empty, and removes
# every driver that reads host state outside the Harmony transport.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_MODULES is not set
# CONFIG_SMP is not set
CONFIG_STATIC_LINK=y
CONFIG_UML_TIME_TRAVEL_SUPPORT=y
CONFIG_HZ_PERIODIC=y
# CONFIG_NO_HZ is not set
# CONFIG_NO_HZ_IDLE is not set
# CONFIG_HIGH_RES_TIMERS is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_IKCONFIG is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_MAGIC_SYSRQ is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_FUTEX=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# CONFIG_HOSTFS is not set
# CONFIG_UML_RANDOM is not set
# CONFIG_HW_RANDOM is not set
# CONFIG_MCONSOLE is not set
# CONFIG_BLK_DEV_UBD is not set
# CONFIG_UML_NET_VECTOR is not set
# CONFIG_SOUND is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_VIRTIO_UML is not set
# CONFIG_PORT_CHAN is not set
# CONFIG_PTY_CHAN is not set
# CONFIG_TTY_CHAN is not set
# CONFIG_XTERM_CHAN is not set
CONFIG_NULL_CHAN=y
CONFIG_CON_ZERO_CHAN="fd:0,fd:1"
CONFIG_CON_CHAN="null"
CONFIG_SSL_CHAN="null"
