# M2 workload-only additions layered on arm64-config-fragment. The clock,
# interrupt, LSE-only and determinism exclusions remain identical to M1.

CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_FUTEX=y
CONFIG_DEVMEM=y
# The control slot and doorbell are VMM-owned physical ranges outside System
# RAM; disabling STRICT_DEVMEM makes that access explicit and auditable.
# CONFIG_STRICT_DEVMEM is not set
CONFIG_MMU=y
# tinyconfig explicitly disables SHMEM, while TMPFS depends on it. Request the
# dependency rather than relying on SHMEM's default so the game profile cannot
# silently publish a kernel without the tmpfs mounted by arm64-game-init.sh.
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_FILE_LOCKING=y
CONFIG_MULTIUSER=y
CONFIG_ADVISE_SYSCALLS=y
