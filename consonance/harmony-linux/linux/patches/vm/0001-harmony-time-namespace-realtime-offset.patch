+/*
+ * Change the realtime offset of a namespace that tasks may already use. The
+ * vDSO reads the namespace offsets inside its sequence loop on the system
+ * VVAR page, so bumping that sequence makes a concurrent reader retry instead
+ * of combining halves of the old and the new offset. Called with offset_lock
+ * held.
+ */
+static void timens_set_realtime(struct time_namespace *ns, s64 realtime)
+{
+	struct timens_offset value = offset_from_ts(ns_to_timespec64(realtime));
+	struct vdso_time_data *vdata;
+	unsigned long flags;
+	unsigned int i;
+
+	WRITE_ONCE(ns->offsets.realtime, realtime);
+	if (!ns->frozen_offsets)
+		return;
+
+	vdata = page_address(ns->vvar_page);
+	flags = vdso_update_begin();
+	for (i = 0; i < CS_BASES; i++) {
+		struct timens_offset *offset = vdata->clock_data[i].offset;
+
+		offset[CLOCK_REALTIME]		= value;
+		offset[CLOCK_REALTIME_COARSE]	= value;
+		offset[CLOCK_REALTIME_ALARM]	= value;
+		offset[CLOCK_TAI]		= value;
+	}
+	vdso_update_end(flags);
+}
