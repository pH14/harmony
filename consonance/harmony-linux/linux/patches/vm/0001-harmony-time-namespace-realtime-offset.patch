+/*
+ * The realtime offset, unlike the monotonic and boottime offsets, may change
+ * while tasks run in the namespace, so readers load it once.
+ */
+static inline s64 timens_realtime_offset(void)
+{
+	return READ_ONCE(current->nsproxy->time_ns->offsets.realtime);
+}
+
+static inline void timens_add_realtime(struct timespec64 *ts)
+{
+	s64 offset = timens_realtime_offset();
+
+	if (offset)
+		*ts = timespec64_add(*ts, ns_to_timespec64(offset));
+}
