+struct harmony_control {
+	uint32_t magic;
+	uint32_t command;
+	uint64_t flags;
+};
+
+struct harmony_ack {
+	uint32_t magic;
+	uint32_t command;
+	int64_t result;
+};
+
+#define HARMONY_FRAME_MAX 4096
+
+static char harmony_frame[HARMONY_FRAME_MAX];
+
+static int harmony_receive(int *fd)
+{
+	char control[CMSG_SPACE(sizeof(int))];
+	struct iovec iov = {
+		.iov_base = harmony_frame,
+		.iov_len = sizeof(harmony_frame),
+	};
+	struct msghdr msg = {
+		.msg_iov = &iov,
+		.msg_iovlen = 1,
+		.msg_control = control,
+		.msg_controllen = sizeof(control),
+	};
+	struct cmsghdr *cmsg;
+	ssize_t n;
+
+	*fd = -1;
+	do {
+		n = recvmsg(harmony_fd, &msg, MSG_TRUNC | MSG_CMSG_CLOEXEC);
+	} while (n < 0 && errno == EINTR);
+	if (n < 0)
+		return -errno;
+	for (cmsg = CMSG_FIRSTHDR(&msg); cmsg; cmsg = CMSG_NXTHDR(&msg, cmsg)) {
+		if (cmsg->cmsg_level == SOL_SOCKET &&
+		    cmsg->cmsg_type == SCM_RIGHTS &&
+		    cmsg->cmsg_len == CMSG_LEN(sizeof(int)) && *fd < 0) {
+			memcpy(fd, CMSG_DATA(cmsg), sizeof(int));
+		}
+	}
+	if (msg.msg_flags & MSG_CTRUNC) {
+		if (*fd >= 0)
+			close(*fd);
+		return -EPROTO;
+	}
+	if (n == 0)
+		return -EPIPE;
+	if ((size_t)n > sizeof(harmony_frame))
+		return -EMSGSIZE;
+	return n;
+}
+
+static int harmony_acknowledge(unsigned int command, long result)
+{
+	struct harmony_ack ack = {
+		.magic = UM_CONTROL_MAGIC,
+		.command = command,
+		.result = result,
+	};
+	ssize_t n;
+
+	do {
+		n = send(harmony_fd, &ack, sizeof(ack), MSG_NOSIGNAL);
+	} while (n < 0 && errno == EINTR);
+	if (n < 0)
+		return -errno;
+	return n == sizeof(ack) ? 0 : -EPROTO;
+}
+
+int os_harmony_memory(long flags, const void *bitmap, unsigned long bytes)
+{
+	struct harmony_control control;
+	ssize_t n;
+	int fd, err;
+
+	err = harmony_acknowledge(UM_CONTROL_MEMORY, flags);
+	if (err)
+		return err;
+	if (!(flags & UM_MEMORY_ALL)) {
+		do {
+			n = send(harmony_fd, bitmap, bytes, MSG_NOSIGNAL);
+		} while (n < 0 && errno == EINTR);
+		if (n < 0)
+			return -errno;
+		if ((unsigned long)n != bytes)
+			return -EPROTO;
+	}
+	n = harmony_receive(&fd);
+	if (n < 0)
+		return n;
+	if (fd >= 0)
+		close(fd);
