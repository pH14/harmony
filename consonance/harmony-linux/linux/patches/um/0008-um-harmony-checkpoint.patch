+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Checkpoints of a User-mode Linux kernel, requested by the Harmony host
+ * while the guest waits for a bridge answer.
+ *
+ * The host process memory and its mappings of kernel virtual memory are
+ * captured in an image. The Harmony host reads and writes the physical memory
+ * file itself, using the pages reported as written since the last capture or
+ * restore. Stub processes and vmalloc aliases write physical memory without
+ * being tracked, so their pages are reported at every command. Stub processes
+ * and epoll registrations are host resources outside that memory, so a
+ * restore tears down the current ones and rebuilds them from the restored
+ * kernel state.
+ */
+#include <linux/init.h>
+#include <linux/irqflags.h>
+#include <linux/kernel.h>
+#include <linux/mm.h>
+#include <linux/pgtable.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/task_stack.h>
+#include <asm/sections.h>
+#include <asm/tlbflush.h>
+#include <linux/time-internal.h>
+#include <as-layout.h>
+#include <checkpoint.h>
+#include <kern_util.h>
+#include <os.h>
+#include <skas.h>
+
+#define MAX_STUB_FDS 1024
+
+static int stub_fds[MAX_STUB_FDS];
+static bool restore_at_boot;
+
+typedef void (*present_fn)(struct mm_struct *mm, unsigned long address,
+			   pte_t *pte);
+
+static void walk_present(struct mm_struct *mm, unsigned long start,
+			 unsigned long end, present_fn fn)
+{
+	unsigned long address = start;
+
+	while (address < end) {
+		pgd_t *pgd = pgd_offset(mm, address);
+		p4d_t *p4d;
+		pud_t *pud;
+		pmd_t *pmd;
+		pte_t *pte;
+
+		if (!pgd_present(*pgd)) {
+			address = pgd_addr_end(address, end);
+			continue;
+		}
+		p4d = p4d_offset(pgd, address);
+		if (!p4d_present(*p4d)) {
+			address = p4d_addr_end(address, end);
+			continue;
+		}
+		pud = pud_offset(p4d, address);
+		if (!pud_present(*pud)) {
+			address = pud_addr_end(address, end);
+			continue;
+		}
+		pmd = pmd_offset(pud, address);
+		if (!pmd_present(*pmd)) {
+			address = pmd_addr_end(address, end);
+			continue;
+		}
+		pte = pte_offset_kernel(pmd, address);
+		if (pte_present(*pte))
+			fn(mm, address, pte);
+		address += PAGE_SIZE;
+	}
+}
+
+static void mark_needsync(struct mm_struct *mm, unsigned long address,
+			  pte_t *pte)
+{
+	*pte = pte_mkneedsync(*pte);
+	um_tlb_mark_sync(mm, address, address + PAGE_SIZE);
+}
+
+void um_checkpoint_mark_present(struct mm_struct *mm, unsigned long start,
+				unsigned long end)
+{
+	walk_present(mm, start, end, mark_needsync);
+}
+
+static void revoke_write(struct mm_struct *mm, unsigned long address,
+			 pte_t *pte)
+{
+	if (pte_write(*pte) && pte_dirty(*pte) && pte_young(*pte))
+		mark_needsync(mm, address, pte);
+}
+
+void um_checkpoint_revoke(struct mm_struct *mm, unsigned long start,
+			  unsigned long end)
+{
+	walk_present(mm, start, end, revoke_write);
+}
+
+int um_checkpoint_write_fault(struct mm_struct *mm, unsigned long address)
+{
+	pgd_t *pgd = pgd_offset(mm, address);
+	p4d_t *p4d;
+	pud_t *pud;
+	pmd_t *pmd;
+	pte_t *pte;
+
+	if (!pgd_present(*pgd))
+		return 0;
+	p4d = p4d_offset(pgd, address);
+	if (!p4d_present(*p4d))
+		return 0;
+	pud = pud_offset(p4d, address);
+	if (!pud_present(*pud))
+		return 0;
+	pmd = pmd_offset(pud, address);
+	if (!pmd_present(*pmd))
+		return 0;
+	pte = pte_offset_kernel(pmd, address);
+	if (!pte_present(*pte) || !pte_write(*pte) || !pte_dirty(*pte) ||
+	    !pte_young(*pte))
+		return 0;
+	os_track_mark(pte_val(*pte) & PAGE_MASK, PAGE_SIZE);
+	mark_needsync(mm, address & PAGE_MASK, pte);
+	return 1;
+}
+
+static void mark_page(struct mm_struct *mm, unsigned long address,
+		      pte_t *pte)
+{
+	os_track_mark(pte_val(*pte) & PAGE_MASK, PAGE_SIZE);
+}
+
+static void mark_untracked(void)
+{
+	walk_present(&init_mm, VMALLOC_START, VMALLOC_END, mark_page);
+	um_checkpoint_mark_stubs();
+}
+
+static void open_stacks(void)
+{
+	struct task_struct *group, *task;
+
+	rcu_read_lock();
+	for_each_process_thread(group, task) {
+		unsigned long stack = (unsigned long)task_stack_page(task);
+
+		os_track_unprotect(stack, stack + THREAD_SIZE);
+	}
+	rcu_read_unlock();
+}
+
+static void fill_args(struct um_checkpoint_args *args, int fd,
+		      unsigned long long flags, int nskip)
+{
+	memset(args, 0, sizeof(*args));
+	args->fd = fd;
+	args->flags = flags;
+	args->skip_fds = stub_fds;
+	args->nskip = nskip;
+	args->physmem_fd = um_physmem_fd();
+	args->physmem_base = uml_physmem;
+	args->physmem_start = uml_reserved;
+	args->physmem_end = high_physmem;
+	args->binary_end = (unsigned long)&_end;
+}
+
+static long capture(unsigned long long flags, int fd, unsigned int *ack)
+{
+	struct um_checkpoint_args args;
+	unsigned long irq;
+	int nskip;
+
+	*ack = UM_CONTROL_CAPTURE;
+	nskip = um_checkpoint_stub_fds(stub_fds, MAX_STUB_FDS);
+	if (nskip < 0) {
+		os_close_file(fd);
+		return nskip;
+	}
+	fill_args(&args, fd, flags, nskip);
+	local_irq_save(irq);
+	mark_untracked();
+	initial_thread_cb(os_checkpoint_capture, &args);
+	os_close_file(fd);
+	open_stacks();
+	if (um_checkpoint_resumed) {
+		um_checkpoint_resumed = 0;
+		um_checkpoint_rebuild_stubs();
+		um_irq_checkpoint_attach();
+		local_irq_restore(irq);
+		*ack = UM_CONTROL_RESTORE;
+		return 0;
+	}
+	local_irq_restore(irq);
+	return args.result;
+}
+
+static long restore(int fd, unsigned int *ack)
+{
+	struct um_checkpoint_args args;
+	unsigned long irq;
+	int nskip;
+
+	*ack = UM_CONTROL_RESTORE;
+	nskip = um_checkpoint_stub_fds(stub_fds, MAX_STUB_FDS);
+	if (nskip < 0) {
+		os_close_file(fd);
+		return nskip;
+	}
+	fill_args(&args, fd, 0, nskip);
+	initial_thread_cb(os_checkpoint_validate, &args);
+	if (args.result) {
+		os_close_file(fd);
+		return args.result;
+	}
+	local_irq_save(irq);
+	mark_untracked();
+	um_checkpoint_kill_stubs();
+	um_irq_checkpoint_detach();
+	initial_thread_cb(os_checkpoint_restore, &args);
+	panic("Harmony checkpoint restore returned\n");
+}
+
+long um_harmony_control(unsigned int command, unsigned long long flags,
+			int fd, unsigned int *ack)
+{
+	switch (command) {
+	case UM_CONTROL_CAPTURE:
+		return capture(flags, fd, ack);
+	case UM_CONTROL_RESTORE:
+		return restore(fd, ack);
+	}
+	*ack = command;
+	os_close_file(fd);
+	return -EINVAL;
+}
+
+static int __init harmony_track_init(void)
+{
+	if (os_harmony_available())
+		os_track_init(uml_physmem, uml_reserved, high_physmem);
+	return 0;
+}
+early_initcall(harmony_track_init);
+
+static int __init harmony_restore_setup(char *line)
+{
+	restore_at_boot = true;
+	return 1;
+}
+__setup("harmony_restore", harmony_restore_setup);
+
+static int __init harmony_restore_at_boot(void)
+{
+	int ret;
+
+	if (!restore_at_boot)
+		return 0;
+	if (!os_harmony_available())
+		panic("harmony_restore needs harmony_fd\n");
+	ret = os_harmony_exchange(time_travel_read(), NULL, 0, NULL, 0);
+	panic("The Harmony host did not restore a checkpoint: %d\n", ret);
+}
+late_initcall_sync(harmony_restore_at_boot);
