+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Host side of User-mode Linux checkpoints.
+ *
+ * Capture and restore run on the host's initial thread stack with every host
+ * signal blocked. An image holds the kernel process's private memory other
+ * than its code and the host stack, the mappings of the physical memory file
+ * outside the direct map, the thread pointer, and the inventory of host
+ * resources that a restore must find unchanged. Stub processes and epoll
+ * registrations are rebuilt by the kernel after a restore.
+ *
+ * The physical memory file is owned by the Harmony host. Both commands
+ * report the pages written since the last capture or restore and wait while
+ * the host reads or rewrites that file. Kernel writes are found by keeping
+ * the direct map read-only until the first write to each page; writes by
+ * guest programs are found when the kernel maps their pages writable.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <sys/sysmacros.h>
+#include <sys/wait.h>
+#ifdef __x86_64__
+#include <asm/prctl.h>
+#endif
+#include <as-layout.h>
+#include <os.h>
+#include <checkpoint.h>
+
+#define IMAGE_MAGIC 0x314b434d4c4d5548ULL
+#define MAX_REGIONS 512
+#define MAX_FDS 128
+#define MAPS_BYTES (256 * 1024)
+#define RESTORE_FAILED 86
+#define UNPROTECT_LIMIT 16384
+#define LONG_BITS (8 * sizeof(unsigned long))
+
+enum region_kind {
+	KIND_PRIVATE = 1,
+	KIND_HEAP,
+	KIND_RESERVE,
+	KIND_IMAGE,
+	KIND_SHARED,
+	KIND_VVAR,
+	KIND_VVAR_VCLOCK,
+	KIND_VDSO,
+};
+
+struct image_region {
+	unsigned long start;
+	unsigned long end;
+	unsigned long offset;
+	unsigned long file_offset;
+	unsigned int prot;
+	unsigned int kind;
+};
+
+struct image_fd {
+	int fd;
+	unsigned int type;
+	unsigned int access;
+	unsigned int reserved;
+};
+
+struct image_header {
+	unsigned long long magic;
+	unsigned long long flags;
+	unsigned long page_size;
+	unsigned long binary_end;
+	unsigned long physmem_base;
+	unsigned long physmem_start;
+	unsigned long physmem_end;
+	unsigned long tls;
+	unsigned long length;
+	unsigned int nregions;
+	unsigned int nfds;
+	struct image_fd fds[MAX_FDS];
+	struct image_region regions[MAX_REGIONS];
+};
+
+struct linux_dirent64 {
+	uint64_t d_ino;
+	int64_t d_off;
+	unsigned short d_reclen;
+	unsigned char d_type;
+	char d_name[];
+};
+
+struct mapping {
+	unsigned long start;
+	unsigned long end;
+	unsigned long offset;
+	unsigned long inode;
+	unsigned int major;
+	unsigned int minor;
+	unsigned int prot;
+	int shared;
+	const char *name;
+};
+
+struct track {
+	unsigned long base;
+	unsigned long start;
+	unsigned long end;
+	unsigned long pages;
+	unsigned long words;
+	unsigned long *bits;
+	unsigned long unprotects;
+	int tracking;
+	int all;
+};
+
+int um_checkpoint_resumed;
+static struct track track;
+
+extern char **environ;
+
+static unsigned long page_size(void)
+{
+	return (unsigned long)sysconf(_SC_PAGESIZE);
+}
+
+static unsigned long round_up(unsigned long value, unsigned long page)
+{
+	return (value + page - 1) & ~(page - 1);
+}
+
+void os_track_init(unsigned long base, unsigned long start, unsigned long end)
+{
+	unsigned long pages = (end - base) >> UM_KERN_PAGE_SHIFT;
+	unsigned long words = (pages + LONG_BITS - 1) / LONG_BITS;
+	void *bits = mmap(NULL, round_up(words * sizeof(long), page_size()),
+			  PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS,
+			  -1, 0);
+
+	if (bits == MAP_FAILED)
+		panic("Harmony write tracking needs %lu bytes: %d\n",
+		      words * sizeof(long), errno);
+	track.base = base;
+	track.start = start;
+	track.end = end;
+	track.pages = pages;
+	track.words = words;
+	track.bits = bits;
+}
+
+static void set_page(unsigned long pfn)
+{
+	track.bits[pfn / LONG_BITS] |= 1UL << (pfn % LONG_BITS);
+}
+
+static int test_page(unsigned long pfn)
+{
+	return (track.bits[pfn / LONG_BITS] >> (pfn % LONG_BITS)) & 1;
+}
+
+int os_track_writable(unsigned long long phys)
+{
+	unsigned long pfn = phys >> UM_KERN_PAGE_SHIFT;
+
+	if (!track.tracking || track.all || pfn >= track.pages)
+		return 1;
+	return test_page(pfn);
+}
+
+void os_track_mark(unsigned long long phys, unsigned long length)
+{
+	unsigned long pfn = phys >> UM_KERN_PAGE_SHIFT;
+	unsigned long last = (phys + length - 1) >> UM_KERN_PAGE_SHIFT;
+
+	if (!track.tracking || track.all || !length)
+		return;
+	for (; pfn <= last && pfn < track.pages; pfn++)
+		set_page(pfn);
+}
+
+static void open_all(void)
+{
+	track.all = 1;
+	if (mprotect((void *)track.start, track.end - track.start,
+		     PROT_READ | PROT_WRITE | PROT_EXEC) < 0)
+		panic("Opening the direct map failed: %d\n", errno);
+}
+
+static void open_range(unsigned long start, unsigned long end)
+{
+	track.unprotects++;
+	if (track.unprotects > UNPROTECT_LIMIT) {
+		open_all();
+		return;
+	}
+	os_track_mark(start - track.base, end - start);
+	if (mprotect((void *)start, end - start,
+		     PROT_READ | PROT_WRITE | PROT_EXEC) < 0)
+		panic("Opening a direct map page failed: %d\n", errno);
+}
+
+void os_track_unprotect(unsigned long start, unsigned long end)
+{
+	if (!track.tracking || track.all)
+		return;
+	if (start < track.start)
+		start = track.start;
+	if (end > track.end)
+		end = track.end;
+	if (start < end)
+		open_range(start, end);
+}
+
+int os_track_fault(unsigned long address)
+{
+	unsigned long page = address & UM_KERN_PAGE_MASK;
+
+	if (!track.tracking || track.all || address < track.start ||
+	    address >= track.end)
+		return 0;
+	open_range(page, page + UM_KERN_PAGE_SIZE);
+	return 1;
+}
+
+static void protect_all(void)
+{
+	if (!track.tracking || track.all)
+		return;
+	if (mprotect((void *)track.start, track.end - track.start,
+		     PROT_READ | PROT_EXEC) < 0)
+		panic("Protecting the direct map failed: %d\n", errno);
+}
+
+static void track_reset(void)
+{
+	memset(track.bits, 0, track.words * sizeof(long));
+	track.unprotects = 0;
+	track.all = 0;
+	track.tracking = 1;
+	protect_all();
+}
+
+static int report_memory(void)
+{
+	long flags = !track.tracking || track.all ? UM_MEMORY_ALL : 0;
+
+	return os_harmony_memory(flags, track.bits,
+				 track.words * sizeof(long));
+}
+
+#if defined(__x86_64__)
+static unsigned long get_tls(void)
+{
+	unsigned long tls = 0;
+
+	syscall(SYS_arch_prctl, ARCH_GET_FS, &tls);
+	return tls;
+}
+
+static void set_tls(unsigned long tls)
+{
+	syscall(SYS_arch_prctl, ARCH_SET_FS, tls);
+}
+#elif defined(__aarch64__)
+static unsigned long get_tls(void)
+{
+	unsigned long tls;
+
+	asm volatile("mrs %0, tpidr_el0" : "=r"(tls));
+	return tls;
+}
+
+static void set_tls(unsigned long tls)
+{
+	asm volatile("msr tpidr_el0, %0" : : "r"(tls));
+}
+#else
+#error "User-mode Linux checkpoints need the host thread pointer"
+#endif
+
+static void fatal(const char *what, int error)
+{
+	char line[160];
+	int n = snprintf(line, sizeof(line),
+			 "Harmony checkpoint restore failed: %s (errno %d)\n",
+			 what, error);
+
+	if (n > 0)
+		write(2, line, n);
+	_exit(RESTORE_FAILED);
+}
+
+static int read_file(const char *path, char *buffer, size_t capacity)
+{
+	size_t length = 0;
+	ssize_t n;
+	int fd = open(path, O_RDONLY | O_CLOEXEC);
+
+	if (fd < 0)
+		return -errno;
+	for (;;) {
+		n = read(fd, buffer + length, capacity - 1 - length);
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0)
+			break;
+		length += n;
+		if (length >= capacity - 1) {
+			close(fd);
+			return -E2BIG;
+		}
+	}
+	close(fd);
+	if (n < 0)
+		return -errno;
+	buffer[length] = '\0';
+	return length;
+}
+
+static int thread_count(void)
+{
+	char stat[1024];
+	char *field;
+	int index;
+	int err = read_file("/proc/self/stat", stat, sizeof(stat));
+
+	if (err < 0)
+		return err;
+	field = strrchr(stat, ')');
+	if (!field)
+		return -EINVAL;
+	for (index = 2; index < 20 && field; index++) {
+		field = strchr(field + 1, ' ');
+	}
+	if (!field)
+		return -EINVAL;
+	return strtol(field + 1, NULL, 10);
+}
+
+static char *parse_mapping(char *line, struct mapping *map)
+{
+	char *next = strchr(line, '\n');
+	char *cursor;
+	char *perms;
+
+	if (next)
+		*next++ = '\0';
+	else
+		next = line + strlen(line);
+
+	map->start = strtoul(line, &cursor, 16);
+	map->end = strtoul(cursor + 1, &cursor, 16);
+	perms = cursor + 1;
+	map->prot = (perms[0] == 'r' ? PROT_READ : 0) |
+		    (perms[1] == 'w' ? PROT_WRITE : 0) |
+		    (perms[2] == 'x' ? PROT_EXEC : 0);
+	map->shared = perms[3] == 's';
+	cursor = perms + 5;
+	map->offset = strtoul(cursor, &cursor, 16);
+	map->major = strtoul(cursor + 1, &cursor, 16);
+	map->minor = strtoul(cursor + 1, &cursor, 16);
+	map->inode = strtoul(cursor + 1, &cursor, 10);
+	while (*cursor == ' ')
+		cursor++;
+	map->name = cursor;
+	return next;
+}
+
+static int name_is(const struct mapping *map, const char *name)
+{
+	return strcmp(map->name, name) == 0;
+}
+
+static int same_file(const struct mapping *map, const struct stat *file)
+{
+	return map->inode == file->st_ino && map->major == major(file->st_dev) &&
+	       map->minor == minor(file->st_dev);
+}
+
+static int skipped(int fd, const struct um_checkpoint_args *args, int own)
+{
+	int i;
+
+	if (fd == args->fd || fd == own)
+		return 1;
+	for (i = 0; i < args->nskip; i++)
+		if (args->skip_fds[i] == fd)
+			return 1;
+	return 0;
+}
+
+static int fd_inventory(const struct um_checkpoint_args *args,
+			struct image_fd *fds, unsigned int *count)
+{
+	char buffer[8192];
+	int dir = open("/proc/self/fd", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	unsigned int n = 0, i, j;
+	long got;
+
+	if (dir < 0)
+		return -errno;
+	while ((got = syscall(SYS_getdents64, dir, buffer, sizeof(buffer))) > 0) {
+		long position = 0;
+
+		while (position < got) {
+			struct linux_dirent64 *entry = (void *)(buffer + position);
+			struct stat file;
+			int fd, flags;
+
+			position += entry->d_reclen;
+			if (entry->d_name[0] < '0' || entry->d_name[0] > '9')
+				continue;
+			fd = strtol(entry->d_name, NULL, 10);
+			if (skipped(fd, args, dir))
+				continue;
+			if (n >= MAX_FDS) {
+				close(dir);
+				return -EMFILE;
+			}
+			if (fstat(fd, &file) < 0 ||
+			    (flags = fcntl(fd, F_GETFL)) < 0) {
+				close(dir);
+				return -errno;
+			}
+			fds[n].fd = fd;
+			fds[n].type = file.st_mode & S_IFMT;
+			fds[n].access = flags & O_ACCMODE;
+			fds[n].reserved = 0;
+			n++;
+		}
+	}
+	close(dir);
+	if (got < 0)
+		return -errno;
+	for (i = 1; i < n; i++)
+		for (j = i; j > 0 && fds[j - 1].fd > fds[j].fd; j--) {
+			struct image_fd swap = fds[j];
+
+			fds[j] = fds[j - 1];
+			fds[j - 1] = swap;
+		}
+	*count = n;
+	return 0;
+}
+
+static int write_all(int fd, const void *data, unsigned long length,
+		     unsigned long offset)
+{
+	const char *cursor = data;
+
+	while (length) {
+		ssize_t n = pwrite(fd, cursor, length, offset);
+
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0)
+			return n < 0 ? -errno : -EIO;
+		cursor += n;
+		offset += n;
+		length -= n;
+	}
+	return 0;
+}
+
+static int read_all(int fd, void *data, unsigned long length,
+		    unsigned long offset)
+{
+	char *cursor = data;
+
+	while (length) {
+		ssize_t n = pread(fd, cursor, length, offset);
+
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0)
+			return n < 0 ? -errno : -EIO;
+		cursor += n;
+		offset += n;
+		length -= n;
+	}
+	return 0;
+}
+
+static int classify(const struct mapping *map, const struct um_checkpoint_args *args,
+		    const struct stat *physmem, struct image_region *region)
+{
+	region->start = map->start;
+	region->end = map->end;
+	region->offset = 0;
+	region->file_offset = map->offset;
+	region->prot = map->prot;
+
+	if (name_is(map, "[vsyscall]") || name_is(map, "[stack]"))
+		return 0;
+	if (name_is(map, "[vvar]")) {
+		region->kind = KIND_VVAR;
+		return 1;
+	}
+	if (name_is(map, "[vvar_vclock]")) {
+		region->kind = KIND_VVAR_VCLOCK;
+		return 1;
+	}
+	if (name_is(map, "[vdso]")) {
+		region->kind = KIND_VDSO;
+		return 1;
+	}
+	if (map->shared) {
+		if (!same_file(map, physmem))
+			return -EINVAL;
+		if (map->start >= args->physmem_start &&
+		    map->end <= args->physmem_end)
+			return 0;
+		region->kind = KIND_SHARED;
+		return 1;
+	}
+	if (name_is(map, "[heap]"))
+		region->kind = KIND_HEAP;
+	else if (map->inode == 0 && !map->prot)
+		region->kind = KIND_RESERVE;
+	else if ((map->prot & PROT_EXEC) && !(map->prot & PROT_WRITE))
+		region->kind = KIND_IMAGE;
+	else
+		region->kind = KIND_PRIVATE;
+	return 1;
+}
+
+static int has_data(const struct image_region *region, unsigned long long flags)
+{
+	switch (region->kind) {
+	case KIND_PRIVATE:
+	case KIND_HEAP:
+		return !(flags & UM_CAPTURE_OMIT_HOST_MEMORY) &&
+		       (region->prot & PROT_READ);
+	}
+	return 0;
+}
+
+static long capture(const struct um_checkpoint_args *args, struct image_header *header,
+		    char *maps)
+{
+	unsigned long page = page_size();
+	unsigned long cursor;
+	struct stat physmem;
+	char *line;
+	unsigned int i;
+	int err;
+
+	memset(header, 0, sizeof(*header));
+	header->magic = IMAGE_MAGIC;
+	header->flags = args->flags;
+	header->page_size = page;
+	header->binary_end = args->binary_end;
+	header->physmem_base = args->physmem_base;
+	header->physmem_start = args->physmem_start;
+	header->physmem_end = args->physmem_end;
+
+	if (fstat(args->physmem_fd, &physmem) < 0)
+		return -errno;
+	err = read_file("/proc/self/maps", maps, MAPS_BYTES);
+	if (err < 0)
+		return err;
+	for (line = maps; *line;) {
+		struct mapping map;
+		struct image_region *region = &header->regions[header->nregions];
+
+		line = parse_mapping(line, &map);
+		if (header->nregions >= MAX_REGIONS)
+			return -E2BIG;
+		err = classify(&map, args, &physmem, region);
+		if (err < 0) {
+			os_warn("Harmony checkpoint: unsupported shared mapping %lx-%lx %s\n",
+				map.start, map.end, map.name);
+			return err;
+		}
+		header->nregions += err;
+	}
+
+	err = fd_inventory(args, header->fds, &header->nfds);
+	if (err)
+		return err;
+	header->tls = get_tls();
+
+	cursor = round_up(sizeof(*header), page);
+	for (i = 0; i < header->nregions; i++) {
+		struct image_region *region = &header->regions[i];
+
+		if (!has_data(region, args->flags))
+			continue;
+		region->offset = cursor;
+		err = write_all(args->fd, (void *)region->start,
+				region->end - region->start, cursor);
+		if (err)
+			return err;
+		cursor += region->end - region->start;
+	}
+	header->length = cursor;
+	if (ftruncate(args->fd, cursor) < 0)
+		return -errno;
+	err = write_all(args->fd, header, sizeof(*header), 0);
+	if (err)
+		return err;
+	return cursor;
+}
+
+void os_checkpoint_capture(void *arg)
+{
+	struct um_checkpoint_args *args = arg;
+	struct image_header header;
+	char maps[MAPS_BYTES];
+	sigset_t all, old;
+	long result;
+
+	sigfillset(&all);
+	sigprocmask(SIG_BLOCK, &all, &old);
+	result = thread_count();
+	if (result == 1)
+		result = report_memory();
+	else if (result >= 0)
+		result = -EBUSY;
+	if (!result) {
+		track_reset();
+		result = capture(args, &header, maps);
+	}
+	sigprocmask(SIG_SETMASK, &old, NULL);
+	args->result = result;
+}
+
+static int read_header(int fd, struct image_header *header)
+{
+	int err = read_all(fd, header, sizeof(*header), 0);
+
+	if (err)
+		return err;
+	if (header->magic != IMAGE_MAGIC || header->page_size != page_size() ||
+	    header->nregions > MAX_REGIONS || header->nfds > MAX_FDS)
+		return -EINVAL;
+	return 0;
+}
+
+static int load_mappings(char *maps, struct mapping *current, int capacity)
+{
+	int n = 0;
+	char *line;
+	int err = read_file("/proc/self/maps", maps, MAPS_BYTES);
+
+	if (err < 0)
+		return err;
+	for (line = maps; *line && n < capacity; n++)
+		line = parse_mapping(line, &current[n]);
+	return *line ? -E2BIG : n;
+}
+
+static const struct mapping *find_special(const struct mapping *current, int n,
+					  unsigned int kind)
+{
+	static const char *const names[] = {
+		[KIND_VVAR] = "[vvar]",
+		[KIND_VVAR_VCLOCK] = "[vvar_vclock]",
+		[KIND_VDSO] = "[vdso]",
+	};
+	int i;
+
+	for (i = 0; i < n; i++)
+		if (name_is(&current[i], names[kind]))
+			return &current[i];
+	return NULL;
+}
+
+static int overlaps(const struct mapping *map, unsigned long start,
+		    unsigned long end)
+{
+	return map->start < end && start < map->end;
+}
+
+static int collision(const struct image_region *region,
+		     const struct mapping *map)
+{
+	os_warn("Harmony checkpoint: %lx-%lx collides with %lx-%lx %s\n",
+		region->start, region->end, map->start, map->end, map->name);
+	return -EEXIST;
+}
+
+static int has_fd(const struct image_fd *fds, unsigned int n,
+		  const struct image_fd *fd)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++)
+		if (!memcmp(&fds[i], fd, sizeof(*fd)))
+			return 1;
+	return 0;
+}
+
+static void report_fds(const struct image_fd *image, unsigned int nimage,
+		       const struct image_fd *now, unsigned int nnow)
+{
+	char path[64], target[256];
+	unsigned int i;
+	ssize_t length;
+
+	os_warn("Harmony checkpoint: open descriptors differ from the image\n");
+	for (i = 0; i < nimage; i++)
+		if (!has_fd(now, nnow, &image[i]))
+			os_warn("Harmony checkpoint: image descriptor %d (type %o, access %u) is not open\n",
+				image[i].fd, image[i].type, image[i].access);
+	for (i = 0; i < nnow; i++) {
+		if (has_fd(image, nimage, &now[i]))
+			continue;
+		snprintf(path, sizeof(path), "/proc/self/fd/%d", now[i].fd);
+		length = readlink(path, target, sizeof(target) - 1);
+		target[length < 0 ? 0 : length] = '\0';
+		os_warn("Harmony checkpoint: descriptor %d (type %o, access %u, %s) is not in the image\n",
+			now[i].fd, now[i].type, now[i].access, target);
+	}
+}
+
+static int validate(const struct um_checkpoint_args *args, struct image_header *header,
+		    char *maps, struct mapping *current)
+{
+	struct image_fd fds[MAX_FDS];
+	unsigned int nfds, i;
+	int n, j, err;
+
+	err = read_header(args->fd, header);
+	if (err)
+		return err;
+	if (header->binary_end != args->binary_end ||
+	    header->physmem_base != args->physmem_base ||
+	    header->physmem_start != args->physmem_start ||
+	    header->physmem_end != args->physmem_end)
+		return -EXDEV;
+	err = thread_count();
+	if (err != 1)
+		return err < 0 ? err : -EBUSY;
+	err = fd_inventory(args, fds, &nfds);
+	if (err)
+		return err;
+	if (nfds != header->nfds ||
+	    memcmp(fds, header->fds, nfds * sizeof(fds[0]))) {
+		report_fds(header->fds, header->nfds, fds, nfds);
+		return -EBADF;
+	}
+
+	n = load_mappings(maps, current, MAX_REGIONS * 2);
+	if (n < 0)
+		return n;
+	for (i = 0; i < header->nregions; i++) {
+		const struct image_region *region = &header->regions[i];
+		const struct mapping *special;
+
+		switch (region->kind) {
+		case KIND_IMAGE:
+			for (j = 0; j < n; j++)
+				if (current[j].start == region->start &&
+				    current[j].end == region->end &&
+				    current[j].prot == region->prot)
+					break;
+			if (j == n) {
+				os_warn("Harmony checkpoint: no mapping %lx-%lx\n",
+					region->start, region->end);
+				return -EFAULT;
+			}
+			break;
+		case KIND_SHARED:
+			break;
+		case KIND_VVAR:
+		case KIND_VVAR_VCLOCK:
+		case KIND_VDSO:
+			special = find_special(current, n, region->kind);
+			if (!special ||
+			    special->end - special->start != region->end - region->start) {
+				os_warn("Harmony checkpoint: vDSO mapping differs\n");
+				return -EFAULT;
+			}
+			if (special->start == region->start)
+				break;
+			for (j = 0; j < n; j++)
+				if (&current[j] != special &&
+				    overlaps(&current[j], region->start, region->end))
+					return collision(region, &current[j]);
+			break;
+		default:
+			for (j = 0; j < n; j++)
+				if (overlaps(&current[j], region->start, region->end) &&
+				    (current[j].shared || current[j].name[0] == '[') &&
+				    !name_is(&current[j], "[heap]"))
+					return collision(region, &current[j]);
+			break;
+		}
+	}
+	return 0;
+}
+
+void os_checkpoint_validate(void *arg)
+{
+	struct um_checkpoint_args *args = arg;
+	struct image_header header;
+	struct mapping current[MAX_REGIONS * 2];
+	char maps[MAPS_BYTES];
+	sigset_t all, old;
+	long result;
+
+	sigfillset(&all);
+	sigprocmask(SIG_BLOCK, &all, &old);
+	protect_all();
+	result = validate(args, &header, maps, current);
+	sigprocmask(SIG_SETMASK, &old, NULL);
+	args->result = result;
+}
+
+static void ensure_mapped(unsigned long start, unsigned long end, int prot)
+{
+	unsigned long page = page_size();
+	unsigned long address = start;
+
+	while (address < end) {
+		unsigned char resident;
+		unsigned long gap;
+
+		if (mincore((void *)address, page, &resident) == 0) {
+			address += page;
+			continue;
+		}
+		if (errno != ENOMEM)
+			fatal("mincore", errno);
+		gap = address;
+		while (gap < end && mincore((void *)gap, page, &resident) < 0 &&
+		       errno == ENOMEM)
+			gap += page;
+		if (mmap((void *)address, gap - address, prot,
+			 MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0) !=
+		    (void *)address)
+			fatal("mapping a captured range", errno);
+		address = gap;
+	}
+}
+
+static void move_special(const struct mapping *current, int n,
+			 const struct image_region *region)
+{
+	const struct mapping *special = find_special(current, n, region->kind);
+	unsigned long length = region->end - region->start;
+
+	if (!special)
+		fatal("missing vDSO mapping", ENOENT);
+	if (special->start == region->start)
+		return;
+	if (mremap((void *)special->start, length, length,
+		   MREMAP_MAYMOVE | MREMAP_FIXED, (void *)region->start) !=
+	    (void *)region->start)
+		fatal("moving the vDSO", errno);
+}
+
+static void restore_region(int image, const struct image_region *region,
+			   const struct mapping *heap)
+{
+	unsigned long length = region->end - region->start;
+	/*
+	 * A writable range keeps its protection while it is copied: it may hold
+	 * the code running this restore, as the single RWX segment of a binary
+	 * linked from one PT_LOAD does.
+	 */
+	int writable = region->prot & PROT_WRITE;
+
+	if (region->kind == KIND_HEAP && heap && heap->start == region->start &&
+	    heap->end < region->end)
+		syscall(SYS_brk, region->end);
+	ensure_mapped(region->start, region->end,
+		      region->kind == KIND_RESERVE || writable ?
+			      region->prot : PROT_READ | PROT_WRITE);
+	if (!region->offset)
+		return;
+	if (!writable &&
+	    mprotect((void *)region->start, length, PROT_READ | PROT_WRITE) < 0)
+		fatal("opening a captured range", errno);
+	if (read_all(image, (void *)region->start, length, region->offset))
+		fatal("reading host memory", errno);
+	if (region->prot & PROT_EXEC)
+		__builtin___clear_cache((char *)region->start,
+					(char *)region->end);
+	if (!writable && mprotect((void *)region->start, length, region->prot) < 0)
+		fatal("protecting a captured range", errno);
+}
+
+void os_checkpoint_restore(void *arg)
+{
+	struct um_checkpoint_args *args = arg;
+	int image = args->fd;
+	int physmem_fd = args->physmem_fd;
+	unsigned long physmem_start = args->physmem_start;
+	unsigned long physmem_end = args->physmem_end;
+	struct stat physmem;
+	struct image_header header;
+	struct mapping current[MAX_REGIONS * 2];
+	const struct mapping *heap = NULL;
+	char maps[MAPS_BYTES];
+	char jmpbuf[256];
+	unsigned long jmpbuf_size;
+	void *initial = os_initial_jmpbuf(&jmpbuf_size);
+	char **environment = environ;
+	struct timespec zero = { 0, 0 };
+	sigset_t all, old, child;
+	unsigned int i;
+	int n;
+
+	sigfillset(&all);
+	sigprocmask(SIG_BLOCK, &all, &old);
+	sigemptyset(&child);
+	sigaddset(&child, SIGCHLD);
+	while (sigtimedwait(&child, NULL, &zero) > 0)
+		;
+	protect_all();
+	n = report_memory();
+	if (n)
+		fatal("exchanging memory with the host", -n);
+
+	if (jmpbuf_size > sizeof(jmpbuf))
+		fatal("initial jump buffer size", EINVAL);
+	memcpy(jmpbuf, initial, jmpbuf_size);
+	if (read_header(image, &header))
+		fatal("reading the image header", errno);
+	n = load_mappings(maps, current, MAX_REGIONS * 2);
+	if (n < 0)
+		fatal("reading host mappings", -n);
+	for (i = 0; i < (unsigned int)n; i++)
+		if (name_is(&current[i], "[heap]"))
+			heap = &current[i];
+
+	for (i = 0; i < header.nregions; i++) {
+		const struct image_region *region = &header.regions[i];
+
+		switch (region->kind) {
+		case KIND_VVAR:
+		case KIND_VVAR_VCLOCK:
+		case KIND_VDSO:
+			move_special(current, n, region);
+			break;
+		}
+	}
+	if (fstat(physmem_fd, &physmem) < 0)
+		fatal("reading the physical memory file", errno);
+	for (i = 0; i < (unsigned int)n; i++)
+		if (current[i].shared && same_file(&current[i], &physmem) &&
+		    (current[i].start < physmem_start ||
+		     current[i].end > physmem_end) &&
+		    munmap((void *)current[i].start,
+			   current[i].end - current[i].start) < 0)
+			fatal("unmapping kernel virtual memory", errno);
+	for (i = 0; i < header.nregions; i++) {
+		const struct image_region *region = &header.regions[i];
+
+		switch (region->kind) {
+		case KIND_SHARED:
+			if (mmap((void *)region->start, region->end - region->start,
+				 region->prot, MAP_SHARED | MAP_FIXED, physmem_fd,
+				 region->file_offset) != (void *)region->start)
+				fatal("mapping kernel virtual memory", errno);
+			break;
+		case KIND_PRIVATE:
+		case KIND_HEAP:
+		case KIND_RESERVE:
+			restore_region(image, region, heap);
+			break;
+		}
+	}
+	track_reset();
+
+	set_tls(header.tls);
+	memcpy(initial, jmpbuf, jmpbuf_size);
+	environ = environment;
+	um_checkpoint_resumed = 1;
+	close(image);
+	sigprocmask(SIG_SETMASK, &old, NULL);
+	os_checkpoint_resume();
+}
+
+void os_checkpoint_kill(int pid)
+{
+	if (pid <= 0)
+		return;
+	kill(pid, SIGKILL);
+	while (waitpid(pid, NULL, __WALL) < 0 && errno == EINTR)
+		;
+}
