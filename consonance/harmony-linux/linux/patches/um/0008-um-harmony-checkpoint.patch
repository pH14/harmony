+int um_checkpoint_stub_fds(int *fds, int capacity)
+{
+	struct mm_context *context;
+	int n = 0;
+
+	guard(spinlock_irqsave)(&mm_list_lock);
+	list_for_each_entry(context, &mm_list, list) {
+		if (!using_seccomp || context->id.sock <= 0)
+			continue;
+		if (n == capacity)
+			return -E2BIG;
+		fds[n++] = context->id.sock;
+	}
+	return n;
+}
+
+void um_checkpoint_kill_stubs(void)
+{
+	struct mm_context *context;
+
+	list_for_each_entry(context, &mm_list, list) {
+		if (context->id.pid > 0)
+			os_checkpoint_kill(context->id.pid);
+		if (using_seccomp && context->id.sock > 0)
+			os_close_file(context->id.sock);
+	}
+}
+
+void um_checkpoint_mark_stubs(void)
+{
+	struct mm_context *context;
+
+	list_for_each_entry(context, &mm_list, list) {
+		struct mm_struct *mm = container_of(context, struct mm_struct, context);
+		struct vm_area_struct *vma;
+		VMA_ITERATOR(vmi, mm, 0);
+
+		if (context->id.stack)
+			os_track_mark(__pa(context->id.stack),
+				      STUB_DATA_PAGES * UM_KERN_PAGE_SIZE);
+		for_each_vma(vmi, vma)
+			um_checkpoint_revoke(mm, vma->vm_start, vma->vm_end);
+	}
+}
+
+void um_checkpoint_rebuild_stubs(void)
+{
+	struct mm_context *context;
+
+	list_for_each_entry(context, &mm_list, list) {
+		struct mm_struct *mm = container_of(context, struct mm_struct, context);
+		struct mm_id *id = &context->id;
+		struct vm_area_struct *vma;
+		VMA_ITERATOR(vmi, mm, 0);
+		int ret;
+
+		if (id->pid <= 0)
+			continue;
+		memset((void *)id->stack, 0, STUB_DATA_PAGES * UM_KERN_PAGE_SIZE);
+		id->pid = -1;
+		id->sock = 0;
+		id->syscall_data_len = 0;
+		id->syscall_fd_num = 0;
+		ret = start_userspace(id);
+		if (ret < 0)
+			panic("Restoring an address space failed: %d\n", ret);
+		unmap(id, 0, STUB_START);
+		for_each_vma(vmi, vma)
+			um_checkpoint_mark_present(mm, vma->vm_start, vma->vm_end);
+	}
+}
