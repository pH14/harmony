--- /dev/null
+++ b/arch/um/os-Linux/harmony.c
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Host side of the User-mode Linux /dev/harmony doorbell. */
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <sys/uio.h>
+#include <init.h>
+#include <os.h>
+
+static int harmony_fd = -1;
+
+static int __init harmony_fd_setup(char *line, int *add)
+{
+	char *end;
+	long fd;
+
+	*add = 0;
+	errno = 0;
+	fd = strtol(line, &end, 10);
+	if (*line == '\0' || *end != '\0' || errno || fd < 0 || fd > INT_MAX) {
+		os_warn("harmony_fd= needs a file descriptor number\n");
+		return 1;
+	}
+	if (fcntl(fd, F_SETFD, FD_CLOEXEC) < 0) {
+		os_warn("harmony_fd=%ld is not an open descriptor\n", fd);
+		return 1;
+	}
+	harmony_fd = fd;
+	return 0;
+}
+
+__uml_setup("harmony_fd=", harmony_fd_setup,
+"harmony_fd=<fd>\n"
+"    An inherited SOCK_SEQPACKET socket that answers every /dev/harmony\n"
+"    request with one response frame. Each request is the virtual time in\n"
+"    nanoseconds as a little-endian 64-bit integer followed by the frame.\n\n"
+);
+
+int os_harmony_available(void)
+{
+	return harmony_fd >= 0;
+}
+
+int os_harmony_exchange(unsigned long long moment, const void *request,
+			unsigned int length, void *response,
+			unsigned int capacity)
+{
+	uint64_t stamp = moment;
+	struct iovec iov[2] = {
+		{ .iov_base = &stamp, .iov_len = sizeof(stamp) },
+		{ .iov_base = (void *)request, .iov_len = length },
+	};
+	struct msghdr msg = { .msg_iov = iov, .msg_iovlen = 2 };
+	ssize_t n;
+
+	do {
+		n = sendmsg(harmony_fd, &msg, MSG_NOSIGNAL);
+	} while (n < 0 && errno == EINTR);
+	if (n < 0)
+		return -errno;
+	if ((size_t)n != sizeof(stamp) + length)
+		return -EPROTO;
+	do {
+		n = recv(harmony_fd, response, capacity, MSG_TRUNC);
+	} while (n < 0 && errno == EINTR);
+	if (n < 0)
+		return -errno;
+	if (n == 0)
+		return -EPIPE;
+	if ((size_t)n > capacity)
+		return -EMSGSIZE;
+	return n;
+}
