--- a/drivers/misc/harmony.c
+++ b/drivers/misc/harmony.c
@@ -27,6 +27,10 @@
 
 #include <asm/io.h>
 #include <asm/ptrace.h>
+#ifdef CONFIG_UML
+#include <linux/time-internal.h>
+#include <os.h>
+#endif
 
 #define HARMONY_DOORBELL_PORT	0x0ca1
 #define HARMONY_DOORBELL_MMIO	0x0a000000UL
@@ -90,7 +94,14 @@ static void __iomem *harmony_doorbell;
 
 static void harmony_ring(u32 length)
 {
-#ifdef CONFIG_X86_64
+#if defined(CONFIG_UML)
+	int ret = os_harmony_exchange(time_travel_read(), harmony_req_page,
+				      length, harmony_resp_page,
+				      HARMONY_PAGE_SIZE);
+
+	if (ret < 0)
+		panic("harmony: host exchange failed: %d\n", ret);
+#elif defined(CONFIG_X86_64)
 	outl(length, HARMONY_DOORBELL_PORT);
 #else
 	writel(length, harmony_doorbell);
@@ -753,10 +764,17 @@ static int __init harmony_init(void)
 {
 	int ret;
 
+#ifdef CONFIG_UML
+	if (!os_harmony_available())
+		return 0;
+	harmony_req_page = (void *)get_zeroed_page(GFP_KERNEL);
+	harmony_resp_page = (void *)get_zeroed_page(GFP_KERNEL);
+#else
 	harmony_req_page = memremap(HARMONY_REQ_GPA, HARMONY_PAGE_SIZE,
 				     MEMREMAP_WB);
 	harmony_resp_page = memremap(HARMONY_RESP_GPA, HARMONY_PAGE_SIZE,
 				      MEMREMAP_WB);
+#endif
 	if (!harmony_req_page || !harmony_resp_page) {
 		ret = -ENOMEM;
 		goto out_unmap;
@@ -779,10 +797,15 @@ out_unmap:
 	if (harmony_doorbell)
 		iounmap(harmony_doorbell);
 #endif
+#ifdef CONFIG_UML
+	free_page((unsigned long)harmony_req_page);
+	free_page((unsigned long)harmony_resp_page);
+#else
 	if (harmony_req_page)
 		memunmap(harmony_req_page);
 	if (harmony_resp_page)
 		memunmap(harmony_resp_page);
+#endif
 	return ret;
 }
 device_initcall(harmony_init);
