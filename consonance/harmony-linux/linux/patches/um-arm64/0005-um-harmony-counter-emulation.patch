+// SPDX-License-Identifier: GPL-2.0
+/* Counter and counter-frequency reads from guest processes, answered from virtual time. */
+#include <linux/signal.h>
+#include <linux/time-internal.h>
+#include <linux/uaccess.h>
+#include <arch.h>
+#include <sysdep/ptrace.h>
+
+#define MRS_RT_MASK		0x1f
+#define MRS_CNTFRQ_EL0		0xd53be000
+#define MRS_CNTVCT_EL0		0xd53be040
+#define MRS_CNTVCTSS_EL0	0xd53be0c0
+#define COUNTER_HZ		1000000000ULL
+
+int arch_emulate_counter(int si_code, struct uml_pt_regs *regs)
+{
+	unsigned long long value;
+	unsigned int rt;
+	u32 insn;
+
+	if (si_code != SI_KERNEL)
+		return 0;
+	if (get_user(insn, (const u32 __user *)UPT_IP(regs)))
+		return 0;
+	switch (insn & ~MRS_RT_MASK) {
+	case MRS_CNTFRQ_EL0:
+		value = COUNTER_HZ;
+		break;
+	case MRS_CNTVCT_EL0:
+	case MRS_CNTVCTSS_EL0:
+		value = time_travel_counter_read();
+		break;
+	default:
+		return 0;
+	}
+	rt = insn & MRS_RT_MASK;
+	if (rt != 31)
+		UPT_X(regs, rt) = value;
+	UPT_IP(regs) += 4;
+	return 1;
+}
