Require SECCOMP userspace in User-mode Linux

Harmony runs User-mode Linux as an ordinary host process with ptrace denied.
The ptrace userspace mode would let a profile silently change its host
interface and its timing, so the kernel accepts only seccomp=on, aborts boot
when the SECCOMP filter cannot be installed, and no longer contains the ptrace
startup checks.

This patch is Linux-kernel code (GPL-2.0), carried as a kernel diff under
consonance/harmony-linux/linux/patches/ per the repository's kernel-patch
exception.

---
--- a/arch/um/os-Linux/start_up.c
+++ b/arch/um/os-Linux/start_up.c
@@ -39,45 +39,6 @@
 #include <skas.h>
 #include "internal.h"
 
-static void ptrace_child(void)
-{
-	int ret;
-	/* Calling os_getpid because some libcs cached getpid incorrectly */
-	int pid = os_getpid(), ppid = getppid();
-	int sc_result;
-
-	if (change_sig(SIGWINCH, 0) < 0 ||
-	    ptrace(PTRACE_TRACEME, 0, 0, 0) < 0) {
-		perror("ptrace");
-		kill(pid, SIGKILL);
-	}
-	kill(pid, SIGSTOP);
-
-	/*
-	 * This syscall will be intercepted by the parent. Don't call more than
-	 * once, please.
-	 */
-	sc_result = os_getpid();
-
-	if (sc_result == pid)
-		/* Nothing modified by the parent, we are running normally. */
-		ret = 1;
-	else if (sc_result == ppid)
-		/*
-		 * Expected in check_ptrace and check_sysemu when they succeed
-		 * in modifying the stack frame
-		 */
-		ret = 0;
-	else
-		/* Serious trouble! This could be caused by a bug in host 2.6
-		 * SKAS3/2.6 patch before release -V6, together with a bug in
-		 * the UML code itself.
-		 */
-		ret = 2;
-
-	exit(ret);
-}
