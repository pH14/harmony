x86: ring the virtual_time tick at execution-density boundaries

VirtualTime execution cannot stop an exit-free userspace stretch or idle-poll
loop at a timer deadline. Give the cooperative Linux guest a deterministic
exit at every native syscall entry, context switch, and idle-poll iteration
(all contract intervals are N=1): a dword OUT of 1 to port 0x0CA3, the x86
form of the arm64 guest's pvclock-frame tick write. The host assigns that
exact tick one fixed sub-period duration, making an armed clockevent due even
after the runnable task blocks and the sole vCPU enters idle polling.

The tick depends only on guest execution boundaries. It reads no counter and
no host time, and the exact port, width, and value are default-denied by the
userspace device model. do_syscall_64 is noinstr, so the tick follows the
harmony_pin_flags rules: an __always_inline body gated on the plain
__ro_after_init bool, with inline-asm port I/O from asm/shared/io.h.

This patch is Linux-kernel code (GPL-2.0), carried as a diff under the Harmony
repository's designated guest-kernel patch exception.

---
--- a/arch/x86/include/asm/harmony_pvclock.h
+++ b/arch/x86/include/asm/harmony_pvclock.h
@@ -4,6 +4,7 @@
 
 #include <linux/types.h>
 #include <asm/processor-flags.h>
+#include <asm/shared/io.h>
 
 /*
  * The frozen CPU contract's pinned MXCSR_MASK (the architectural default,
@@ -59,4 +60,27 @@
 }
 #endif
 
+/*
+ * The virtual_time execution tick: one OUT per syscall entry, context
+ * switch, and idle-poll iteration (all contract intervals are N=1). The
+ * write is the VM exit; the host assigns it a fixed sub-period duration so
+ * an exit-free execution stretch still reaches an armed clockevent
+ * deadline. The exact port, width, and value are default-denied by the
+ * userspace device model. Same noinstr rules as harmony_pin_flags: the
+ * gate is the plain __ro_after_init bool and outl is inline asm.
+ */
+#define HARMONY_VIRTUAL_TIME_TICK_PORT 0x0CA3
+
+#ifdef CONFIG_HARMONY_PVCLOCK
+static __always_inline void harmony_virtual_time_tick(void)
+{
+	if (harmony_pvclock_flags_pinned)
+		outl(1, HARMONY_VIRTUAL_TIME_TICK_PORT);
+}
+#else
+static __always_inline void harmony_virtual_time_tick(void)
+{
+}
+#endif
+
 #endif /* _ASM_X86_HARMONY_PVCLOCK_H */
--- a/arch/x86/entry/syscall_64.c
+++ b/arch/x86/entry/syscall_64.c
@@ -92,6 +92,7 @@
 	 * SYSRET then returns with the pinned image in R11.
 	 */
 	regs->flags = harmony_pin_flags(regs->flags);
+	harmony_virtual_time_tick();
 	add_random_kstack_offset();
 	nr = syscall_enter_from_user_mode(regs, nr);
 
--- a/arch/x86/kernel/process_64.c
+++ b/arch/x86/kernel/process_64.c
@@ -57,6 +57,7 @@
 #include <asm/unistd.h>
 #include <asm/fsgsbase.h>
 #include <asm/fred.h>
+#include <asm/harmony_pvclock.h>
 #include <asm/msr.h>
 #ifdef CONFIG_IA32_EMULATION
 /* Not included via unistd.h */
@@ -620,6 +621,8 @@
 	WARN_ON_ONCE(IS_ENABLED(CONFIG_DEBUG_ENTRY) &&
 		     this_cpu_read(hardirq_stack_inuse));
 
+	harmony_virtual_time_tick();
+
 	switch_fpu(prev_p, cpu);
 
 	/* We must save %fs and %gs before load_TLS() because
--- a/kernel/sched/idle.c
+++ b/kernel/sched/idle.c
@@ -11,6 +11,10 @@
 #include <linux/livepatch.h>
 #include "sched.h"
 #include "smp.h"
+
+#ifdef CONFIG_HARMONY_PVCLOCK
+#include <asm/harmony_pvclock.h>
+#endif
 
 /* Linker adds these: start and end of __cpuidle functions */
 extern char __cpuidle_text_start[], __cpuidle_text_end[];
@@ -64,7 +68,11 @@
 	raw_local_irq_enable();
 	while (!tif_need_resched() &&
 	       (cpu_idle_force_poll || tick_check_broadcast_expired()))
+#ifdef CONFIG_HARMONY_PVCLOCK
+		harmony_virtual_time_tick();
+#else
 		cpu_relax();
