+#ifdef CONFIG_HARMONY_USER_COUNTER_TRAPS
+/*
+ * CR4.TSD raises #GP(0) before RDTSC/RDTSCP executes. Decode through the
+ * kernel's checked user fetch so a faulting or unmapped instruction cannot
+ * make the #GP handler dereference user memory. Only the two exact opcode
+ * forms are accepted; unrelated #GPs remain on the normal signal path.
+ */
+static bool harmony_emulate_user_counter(struct pt_regs *regs,
+					 unsigned long error_code)
+{
+	unsigned char buf[MAX_INSN_SIZE] = { 0 };
+	struct insn insn;
+	u64 value;
+	u32 aux;
+	int nr_copied;
+	bool rdtscp;
+
+	if (error_code || !test_thread_flag(TIF_NOTSC))
+		return false;
+
+	nr_copied = insn_fetch_from_user(regs, buf);
+	if (nr_copied <= 0 ||
+	    !insn_decode_from_regs(&insn, regs, buf, nr_copied) ||
+	    insn_get_opcode(&insn) || insn_get_modrm(&insn))
+		return false;
+
+	/* RDTSCP is 0f 01 with f9 in the decoder's ModRM field. */
+	rdtscp = insn.opcode.nbytes == 2 &&
+		  insn.opcode.bytes[0] == 0x0f &&
+		  insn.opcode.bytes[1] == 0x01 &&
+		  insn.modrm.nbytes == 1 &&
+		  insn.modrm.bytes[0] == 0xf9;
+	if (!rdtscp && !(insn.opcode.nbytes == 2 &&
+			 insn.opcode.bytes[0] == 0x0f &&
+			 insn.opcode.bytes[1] == 0x31))
+		return false;
+
+	/* Charge the deterministic execution boundary before reading the clock. */
+	harmony_virtual_time_tick();
+	if (!harmony_pvclock_read_user_counter(&value, &aux))
+		return false;
+
+	regs->ax = (u32)value;
+	regs->dx = value >> 32;
+	if (rdtscp)
+		regs->cx = aux;
+	regs->ip += insn.length;
+	return true;
+}
+#else
+static bool harmony_emulate_user_counter(struct pt_regs *regs,
+					 unsigned long error_code)
+{
+	(void)regs;
+	(void)error_code;
+	return false;
+}
+#endif
+
 DEFINE_IDTENTRY_ERRORCODE(exc_general_protection)
 {
 	char desc[sizeof(GPFSTR) + 50 + 2*sizeof(unsigned long) + 1] = GPFSTR;
@@ -813,6 +873,9 @@
 	}
 
 	if (user_mode(regs)) {
+		if (harmony_emulate_user_counter(regs, error_code))
+			goto exit;
+
 		if (fixup_iopl_exception(regs))
 			goto exit;
 
