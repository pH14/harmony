--- a/arch/x86/kernel/harmony_pvclock.c
+++ b/arch/x86/kernel/harmony_pvclock.c
@@ -372,3 +372,42 @@
 	return 0;
 }
 early_initcall(harmony_pvclock_init);
+
+/*
+ * Return the materialized counter in the units promised by the ABI. The
+ * page's guest_clock is already the architectural TSC projection at
+ * guest_clock_hz, so converting vns here would both lose precision and
+ * disagree with the VMM's RDMSR/RDTSC oracle. A stable ABI-v1 page pins the
+ * only guest vCPU to AUX zero; reject anything else rather than expose a
+ * host or partially initialized value.
+ */
+bool harmony_pvclock_read_user_counter(u64 *value, u32 *aux)
+{
+	const struct harmony_pvclock_page *p = &harmony_page;
+	u32 seq, abi, flags, vcpu;
+	u64 gc, hz;
+
+	if (!harmony_pvclock_requested())
+		return false;
+
+	do {
+		while ((seq = READ_ONCE(p->seq)) & 1)
+			cpu_relax();
+		virt_rmb();
+		abi = READ_ONCE(p->abi_version);
+		gc = READ_ONCE(p->guest_clock);
+		hz = READ_ONCE(p->guest_clock_hz);
+		flags = READ_ONCE(p->flags);
+		vcpu = READ_ONCE(p->vcpu_index);
+		virt_rmb();
+	} while (unlikely(READ_ONCE(p->seq) != seq));
+
+	if (abi != HARMONY_PVCLOCK_ABI || flags != HARMONY_FLAGS_V1 ||
+	    vcpu != 0 || hz == 0)
+		return false;
+
+	*value = gc;
+	*aux = vcpu;
+	return true;
+}
+EXPORT_SYMBOL_GPL(harmony_pvclock_read_user_counter);
