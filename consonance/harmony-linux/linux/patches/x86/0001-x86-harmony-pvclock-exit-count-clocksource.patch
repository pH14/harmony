--- a/arch/x86/include/asm/harmony_pvclock.h
+++ b/arch/x86/include/asm/harmony_pvclock.h
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_X86_HARMONY_PVCLOCK_H
+#define _ASM_X86_HARMONY_PVCLOCK_H
+
+#include <linux/types.h>
+#include <asm/processor-flags.h>
+#include <asm/shared/io.h>
+
+/*
+ * The frozen CPU contract's pinned MXCSR_MASK (the architectural default,
+ * no vendor bits). FXSAVE and the XSAVE variants store the host's real mask
+ * into every save image they write, so harmony save paths overwrite the
+ * field with this value to keep saved FPU state host-neutral; the restore
+ * instructions ignore the field.
+ */
+#define HARMONY_MXCSR_MASK_PINNED 0x0000ffff
+
+/*
+ * The harmony determinism guest's time-ownership interface, consumed by the
+ * boot TSC paths (tsc.c) and the entropy-timing accessor (timex.h). Both
+ * calls answer for kernels booted WITHOUT the harmony_pvclock parameter too,
+ * so ordinary kernels built with CONFIG_HARMONY_PVCLOCK behave exactly as
+ * before.
+ */
+#ifdef CONFIG_HARMONY_PVCLOCK
+bool harmony_pvclock_requested(void);
+u64 harmony_pvclock_entropy_cycles(void);
+#else
+static inline bool harmony_pvclock_requested(void)
+{
+	return false;
+}
+static inline u64 harmony_pvclock_entropy_cycles(void)
+{
+	return 0;
+}
+#endif
+
+/*
+ * AF after shifts and multiplies is architecturally undefined and the two
+ * x86 vendors produce different values. Every flags word the kernel stores
+ * -- exception and interrupt frames (pt_regs), the syscall R11 image,
+ * local_irq_save() -- would otherwise carry that vendor-specific bit into
+ * guest memory. No 64-bit-mode instruction reads AF, so the deterministic
+ * guest clears it wherever flags become data. The gate is a plain
+ * __ro_after_init bool (no call) so noinstr entry paths can use it.
+ */
+#ifdef CONFIG_HARMONY_PVCLOCK
+extern bool harmony_pvclock_flags_pinned;
+static __always_inline unsigned long harmony_pin_flags(unsigned long flags)
+{
+	if (harmony_pvclock_flags_pinned)
+		flags &= ~(unsigned long)X86_EFLAGS_AF;
+	return flags;
+}
+#else
+static __always_inline unsigned long harmony_pin_flags(unsigned long flags)
+{
+	return flags;
+}
+#endif
+
+/*
+ * The virtual_time execution tick: one OUT per syscall entry, context
+ * switch, and idle-poll iteration (all contract intervals are N=1). The
+ * write is the VM exit; the host assigns it a fixed sub-period duration so
+ * an exit-free execution stretch still reaches an armed clockevent
+ * deadline. The exact port, width, and value are default-denied by the
+ * userspace device model. Same noinstr rules as harmony_pin_flags: the
+ * gate is the plain __ro_after_init bool and outl is inline asm.
+ */
+#define HARMONY_VIRTUAL_TIME_TICK_PORT 0x0CA3
+
+#ifdef CONFIG_HARMONY_PVCLOCK
+static __always_inline void harmony_virtual_time_tick(void)
+{
+	if (harmony_pvclock_flags_pinned)
+		outl(1, HARMONY_VIRTUAL_TIME_TICK_PORT);
+}
+#else
+static __always_inline void harmony_virtual_time_tick(void)
+{
+}
+#endif
+
+#endif /* _ASM_X86_HARMONY_PVCLOCK_H */
