--- /dev/null
+++ b/drivers/misc/harmony_park.c
@@ -0,0 +1,404 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * /dev/harmony-park: hold one thread of a workload at an instruction.
+ *
+ * One park per open file. Arming places a hardware execution breakpoint on
+ * every thread of a process group, at a user address, as an in-kernel perf
+ * event. The kernel counts the hits; the thread that takes the k-th hit
+ * queues work for its own return to user mode and sleeps there, before the
+ * instruction runs, until the monotonic clock passes the hold. Every other
+ * task runs meanwhile. The sleeper is woken by the first system call from
+ * another task that sees the deadline passed, or by the periodic tick. No
+ * signal is sent and no tracer is attached, so the workload observes only
+ * the passage of time.
+ */
+#define pr_fmt(fmt) "harmony-park: " fmt
+
+#include <linux/atomic.h>
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/harmony_park.h>
+#include <linux/hrtimer.h>
+#include <linux/hw_breakpoint.h>
+#include <linux/ioctl.h>
+#include <linux/kref.h>
+#include <linux/ktime.h>
+#include <linux/list.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/perf_event.h>
+#include <linux/pid.h>
+#include <linux/ptrace.h>
+#include <linux/rcupdate.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/task.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/task_work.h>
+#include <linux/types.h>
+#include <linux/uaccess.h>
+
+/* Threads one park can watch; a debug register slot is taken on each. */
+#define HARMONY_PARK_MAX_TASKS 256U
+
+/* Mirrored by the fault agent; fixed-width so the layout is the same everywhere. */
+struct harmony_park_arm {
+	__u32 pgid;
+	__u32 reserved;
+	__u64 addr;
+	__u64 hits;
+	__u64 hold_ns;
+};
+
+struct harmony_park_status {
+	__u32 state;
+	__u32 tasks;
+	__u64 hits;
+	__u64 pc;
+	__u32 pid;
+	__u32 reserved;
+	__u64 parked_ns;
+	__u64 released_ns;
+};
+
+enum harmony_park_state {
+	HARMONY_PARK_EMPTY = 0,
+	HARMONY_PARK_ARMED = 1,
+	HARMONY_PARK_PARKED = 2,
+	HARMONY_PARK_RELEASED = 3,
+	HARMONY_PARK_DISARMED = 4,
+};
+
+#define HARMONY_PARK_IOC_MAGIC 'P'
+#define HARMONY_PARK_IOC_ARM _IOW(HARMONY_PARK_IOC_MAGIC, 1, struct harmony_park_arm)
+#define HARMONY_PARK_IOC_STATUS _IOR(HARMONY_PARK_IOC_MAGIC, 2, struct harmony_park_status)
+
+struct harmony_park {
+	struct kref ref;
+	/* Serializes arming and the two paths that remove the breakpoints. */
+	struct mutex lock;
+	atomic_t state;
+	atomic64_t hits;
+	u64 target;
+	u64 hold_ns;
+	u64 addr;
+	struct perf_event **events;
+	unsigned int count;
+	unsigned int tasks;
+	struct callback_head work;
+	/* Valid while the park is on the sleeper list. */
+	struct task_struct *sleeper;
+	struct list_head sleeping;
+	u32 pid;
+	u64 pc;
+	u64 parked_ns;
+	u64 deadline_ns;
+	u64 released_ns;
+};
+
+bool harmony_park_sleeping;
+EXPORT_SYMBOL_GPL(harmony_park_sleeping);
+
+static DEFINE_SPINLOCK(harmony_park_sleepers_lock);
+static LIST_HEAD(harmony_park_sleepers);
+
+/*
+ * Execution breakpoints are whole-instruction matches: x86 wants the word
+ * length and arm64 the instruction length.
+ */
+static u64 harmony_park_exec_len(void)
+{
+#ifdef CONFIG_ARM64
+	return HW_BREAKPOINT_LEN_4;
+#else
+	return sizeof(long);
+#endif
+}
+
+static void harmony_park_free(struct kref *ref)
+{
+	struct harmony_park *park = container_of(ref, struct harmony_park, ref);
+
+	kfree(park->events);
+	kfree(park);
+}
+
+static void harmony_park_unregister(struct harmony_park *park)
+{
+	unsigned int i;
+
+	mutex_lock(&park->lock);
+	for (i = 0; i < park->count; i++) {
+		unregister_hw_breakpoint(park->events[i]);
+		park->events[i] = NULL;
+	}
+	park->count = 0;
+	mutex_unlock(&park->lock);
+}
+
+void harmony_park_poll_slow(void)
+{
+	struct harmony_park *park;
+	u64 now = ktime_get_ns();
+
+	spin_lock(&harmony_park_sleepers_lock);
+	list_for_each_entry(park, &harmony_park_sleepers, sleeping) {
+		if (now >= park->deadline_ns)
+			wake_up_process(park->sleeper);
+	}
+	spin_unlock(&harmony_park_sleepers_lock);
+}
+EXPORT_SYMBOL_GPL(harmony_park_poll_slow);
+
+static void harmony_park_work(struct callback_head *head)
+{
+	struct harmony_park *park = container_of(head, struct harmony_park, work);
+	ktime_t deadline;
+
+	harmony_park_unregister(park);
+
+	park->parked_ns = ktime_get_ns();
+	park->deadline_ns = park->parked_ns + park->hold_ns;
+	park->sleeper = current;
+	deadline = ns_to_ktime(park->deadline_ns);
+
+	spin_lock(&harmony_park_sleepers_lock);
+	list_add_tail(&park->sleeping, &harmony_park_sleepers);
+	WRITE_ONCE(harmony_park_sleeping, true);
+	spin_unlock(&harmony_park_sleepers_lock);
+
+	/*
+	 * The timer is the bound: without high-resolution timers it fires at
+	 * the first tick past the deadline. The poll from other tasks' system
+	 * calls usually wakes the sleeper earlier and closer to the deadline.
+	 */
+	for (;;) {
+		set_current_state(TASK_UNINTERRUPTIBLE);
+		if (ktime_get_ns() >= park->deadline_ns)
+			break;
+		schedule_hrtimeout(&deadline, HRTIMER_MODE_ABS);
+	}
+	__set_current_state(TASK_RUNNING);
+
+	spin_lock(&harmony_park_sleepers_lock);
+	list_del(&park->sleeping);
+	WRITE_ONCE(harmony_park_sleeping, !list_empty(&harmony_park_sleepers));
+	spin_unlock(&harmony_park_sleepers_lock);
+
+	park->sleeper = NULL;
+	park->released_ns = ktime_get_ns();
+	atomic_set(&park->state, HARMONY_PARK_RELEASED);
+	kref_put(&park->ref, harmony_park_free);
+}
+
+/*
+ * Runs in the debug exception of the thread that hit the breakpoint. Nothing
+ * here may sleep; the park itself happens in the task work, in the thread's
+ * own context, after the exception has returned.
+ */
+static void harmony_park_hit(struct perf_event *bp, struct perf_sample_data *data,
+			     struct pt_regs *regs)
+{
+	struct harmony_park *park = bp->overflow_handler_context;
+
+	if (!user_mode(regs))
+		return;
+	if ((u64)atomic64_inc_return(&park->hits) != park->target)
+		return;
+	if (atomic_cmpxchg(&park->state, HARMONY_PARK_ARMED, HARMONY_PARK_PARKED) !=
+	    HARMONY_PARK_ARMED)
+		return;
+	park->pc = instruction_pointer(regs);
+	park->pid = task_pid_nr(current);
+	kref_get(&park->ref);
+	init_task_work(&park->work, harmony_park_work);
+	if (task_work_add(current, &park->work, TWA_RESUME)) {
+		/* The thread is exiting; the file's reference keeps the park. */
+		atomic_set(&park->state, HARMONY_PARK_RELEASED);
+		kref_put(&park->ref, harmony_park_free);
+	}
+}
+
+static int harmony_park_do_arm(struct harmony_park *park, const struct harmony_park_arm *arm)
+{
+	struct perf_event_attr attr;
+	struct task_struct **tasks;
+	struct task_struct *p, *t;
+	struct pid *pgrp;
+	unsigned int n = 0;
+	unsigned int i;
+	int ret = 0;
+
+	if (arm->reserved != 0 || arm->hits == 0 || arm->hold_ns == 0)
+		return -EINVAL;
+
+	tasks = kcalloc(HARMONY_PARK_MAX_TASKS, sizeof(*tasks), GFP_KERNEL);
+	if (!tasks)
+		return -ENOMEM;
+
+	pgrp = find_get_pid(arm->pgid);
+	if (!pgrp) {
+		kfree(tasks);
+		return -ESRCH;
+	}
+	rcu_read_lock();
+	do_each_pid_task(pgrp, PIDTYPE_PGID, p) {
+		for_each_thread(p, t) {
+			if (n == HARMONY_PARK_MAX_TASKS)
+				break;
+			get_task_struct(t);
+			tasks[n++] = t;
+		}
+	} while_each_pid_task(pgrp, PIDTYPE_PGID, p);
+	rcu_read_unlock();
+	put_pid(pgrp);
+
+	if (n == 0) {
+		kfree(tasks);
+		return -ESRCH;
+	}
+
+	hw_breakpoint_init(&attr);
+	attr.bp_addr = arm->addr;
+	attr.bp_len = harmony_park_exec_len();
+	attr.bp_type = HW_BREAKPOINT_X;
+
+	mutex_lock(&park->lock);
+	if (atomic_read(&park->state) != HARMONY_PARK_EMPTY) {
+		ret = -EBUSY;
+		goto out;
+	}
+	park->events = kcalloc(n, sizeof(*park->events), GFP_KERNEL);
+	if (!park->events) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	park->target = arm->hits;
+	park->hold_ns = arm->hold_ns;
+	park->addr = arm->addr;
+	park->tasks = n;
+	atomic64_set(&park->hits, 0);
+	/*
+	 * A thread that is exiting or has no free debug register is skipped;
+	 * the park needs one watched thread, and reports how many it got.
+	 */
+	for (i = 0; i < n; i++) {
+		struct perf_event *bp;
+
+		bp = register_user_hw_breakpoint(&attr, harmony_park_hit, park, tasks[i]);
+		if (IS_ERR(bp)) {
+			ret = PTR_ERR(bp);
+			continue;
+		}
+		park->events[park->count++] = bp;
+	}
+	if (park->count == 0) {
+		kfree(park->events);
+		park->events = NULL;
+		goto out;
+	}
+	park->tasks = park->count;
+	ret = 0;
+	/* Every breakpoint is in place before a hit can count. */
+	smp_wmb();
+	atomic_set(&park->state, HARMONY_PARK_ARMED);
+out:
+	mutex_unlock(&park->lock);
+	for (i = 0; i < n; i++)
+		put_task_struct(tasks[i]);
+	kfree(tasks);
+	return ret;
+}
+
+static long harmony_park_ioctl(struct file *file, unsigned int command, unsigned long argument)
+{
+	struct harmony_park *park = file->private_data;
+	void __user *argp = (void __user *)argument;
+
+	switch (command) {
+	case HARMONY_PARK_IOC_ARM: {
+		struct harmony_park_arm arm;
+
+		if (copy_from_user(&arm, argp, sizeof(arm)))
+			return -EFAULT;
+		return harmony_park_do_arm(park, &arm);
+	}
+	case HARMONY_PARK_IOC_STATUS: {
+		struct harmony_park_status status = {
+			.state = atomic_read(&park->state),
+			.tasks = park->tasks,
+			.hits = atomic64_read(&park->hits),
+			.pc = park->pc,
+			.pid = park->pid,
+			.parked_ns = park->parked_ns,
+			.released_ns = park->released_ns,
+		};
+
+		if (copy_to_user(argp, &status, sizeof(status)))
+			return -EFAULT;
+		return 0;
+	}
+	default:
+		return -ENOTTY;
+	}
+}
+
+static int harmony_park_open(struct inode *inode, struct file *file)
+{
+	struct harmony_park *park;
+
+	park = kzalloc(sizeof(*park), GFP_KERNEL);
+	if (!park)
+		return -ENOMEM;
+	kref_init(&park->ref);
+	mutex_init(&park->lock);
+	atomic_set(&park->state, HARMONY_PARK_EMPTY);
+	INIT_LIST_HEAD(&park->sleeping);
+	file->private_data = park;
+	return nonseekable_open(inode, file);
+}
+
+/*
+ * Closing the file disarms a park that has not fired. A hold already in
+ * progress runs to its deadline: the hold belongs to the hit, and the task
+ * work holds its own reference.
+ */
+static int harmony_park_release(struct inode *inode, struct file *file)
+{
+	struct harmony_park *park = file->private_data;
+
+	atomic_cmpxchg(&park->state, HARMONY_PARK_ARMED, HARMONY_PARK_DISARMED);
+	harmony_park_unregister(park);
+	kref_put(&park->ref, harmony_park_free);
+	return 0;
+}
+
+static const struct file_operations harmony_park_fops = {
+	.owner = THIS_MODULE,
+	.open = harmony_park_open,
+	.release = harmony_park_release,
+	.unlocked_ioctl = harmony_park_ioctl,
+	.compat_ioctl = harmony_park_ioctl,
+	.llseek = noop_llseek,
+};
+
+static struct miscdevice harmony_park_device = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "harmony-park",
+	.fops = &harmony_park_fops,
+	.mode = 0666,
+};
+
+static int __init harmony_park_init(void)
+{
+	int ret;
+
+	ret = misc_register(&harmony_park_device);
+	if (ret)
+		return ret;
+	pr_info("registered /dev/harmony-park\n");
+	return 0;
+}
+device_initcall(harmony_park_init);
--- /dev/null
+++ b/include/linux/harmony_park.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_HARMONY_PARK_H
+#define _LINUX_HARMONY_PARK_H
+
+#include <linux/compiler.h>
+#include <linux/types.h>
+
+#ifdef CONFIG_HARMONY_PARK
+extern bool harmony_park_sleeping;
+void harmony_park_poll_slow(void);
+
+/*
+ * Called at system call entry, in process context with interrupts enabled.
+ * A parked thread whose hold has elapsed is woken here, so its release is as
+ * fine as the other tasks' system calls; the periodic timer is the bound.
+ */
+static inline void harmony_park_poll(void)
+{
+	if (unlikely(READ_ONCE(harmony_park_sleeping)))
+		harmony_park_poll_slow();
+}
+#else
+static inline void harmony_park_poll(void)
+{
+}
+#endif
+
+#endif /* _LINUX_HARMONY_PARK_H */
--- a/arch/x86/entry/syscall_64.c
+++ b/arch/x86/entry/syscall_64.c
@@ -9,6 +9,7 @@
 #include <linux/nospec.h>
 #include <asm/syscall.h>
 #include <asm/harmony_pvclock.h>
+#include <linux/harmony_park.h>
 
 #define __SYSCALL(nr, sym) extern long __x64_##sym(const struct pt_regs *);
 #define __SYSCALL_NORETURN(nr, sym) extern long __noreturn __x64_##sym(const struct pt_regs *);
@@ -98,6 +99,8 @@
 
 	instrumentation_begin();
 
+	harmony_park_poll();
+
 	if (!do_syscall_x64(regs, nr) && !do_syscall_x32(regs, nr) && nr != -1) {
 		/* Invalid system call, but still a system call. */
 		regs->ax = __x64_sys_ni_syscall(regs);
