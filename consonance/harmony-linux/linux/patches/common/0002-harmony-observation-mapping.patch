+struct harmony_region_request {
+	__u32 length;
+	__u32 handle;
+};
+
+#define HARMONY_IOC_REGION _IOWR(HARMONY_IOC_MAGIC, 2, struct harmony_region_request)
+#define HARMONY_REGION_MAX (2U * 1024U * 1024U)
+#define HARMONY_REGION_LIMIT 16U
+#define HARMONY_REGION_EVENT 0x04000002U
+
+static u32 harmony_region_next = 1;
+static u32 harmony_region_count;
+
+static int harmony_region_event(struct harmony_file *state, bool active)
+{
+	u8 payload[28] = { 0 };
+	u32 response_len = 0;
+	int ret;
+
+	put_unaligned_le32(HARMONY_REGION_EVENT, payload);
+	put_unaligned_le32(1, payload + 4);
+	put_unaligned_le32(state->region_handle, payload + 8);
+	if (active) {
+		put_unaligned_le64(virt_to_phys(state->region), payload + 12);
+		put_unaligned_le32(state->region_len, payload + 20);
+	}
+	ret = harmony_exchange(HC_SERVICE_EVENT, HC_OPCODE_ONE,
+			       payload, sizeof(payload), NULL, 0, &response_len);
+	if (!ret && response_len)
+		ret = -EPROTO;
+	return ret;
+}
+
+static long harmony_region_create(struct file *file, void __user *argp)
+{
+	struct harmony_file *state = file->private_data;
+	struct harmony_region_request request;
+	int ret;
+
+	if (copy_from_user(&request, argp, sizeof(request)))
+		return -EFAULT;
+	if (!request.length || request.length > HARMONY_REGION_MAX || request.handle)
+		return -EINVAL;
+	if (mutex_lock_interruptible(&harmony_lock))
+		return -ERESTARTSYS;
+	if (state->region) {
+		ret = -EALREADY;
+		goto out;
+	}
+	if (harmony_region_count >= HARMONY_REGION_LIMIT || !harmony_region_next) {
+		ret = -ENOSPC;
+		goto out;
+	}
+	state->region = alloc_pages_exact(PAGE_ALIGN(request.length), GFP_KERNEL | __GFP_ZERO);
+	if (!state->region) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	state->region_len = request.length;
+	state->region_handle = harmony_region_next++;
+	ret = harmony_region_event(state, true);
+	if (ret) {
+		free_pages_exact(state->region, PAGE_ALIGN(state->region_len));
+		state->region = NULL;
+		goto out;
+	}
+	harmony_region_count++;
+	request.handle = state->region_handle;
+	ret = copy_to_user(argp, &request, sizeof(request)) ? -EFAULT : 0;
+out:
+	mutex_unlock(&harmony_lock);
+	return ret;
+}
+
+static int harmony_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	struct harmony_file *state = file->private_data;
+	int ret;
+
+	if (mutex_lock_interruptible(&harmony_lock))
+		return -ERESTARTSYS;
+	if (!state->region || vma->vm_pgoff ||
+	    vma->vm_end - vma->vm_start != PAGE_ALIGN(state->region_len) ||
+	    !(vma->vm_flags & VM_SHARED) || (vma->vm_flags & VM_EXEC)) {
+		ret = -EINVAL;
+		goto out;
+	}
+	vm_flags_set(vma, VM_DONTEXPAND | VM_DONTDUMP);
+	vm_flags_clear(vma, VM_MAYEXEC);
+	ret = remap_pfn_range(vma, vma->vm_start,
+			     virt_to_phys(state->region) >> PAGE_SHIFT,
+			     PAGE_ALIGN(state->region_len), vma->vm_page_prot);
+out:
+	mutex_unlock(&harmony_lock);
+	return ret;
+}
+
 static int harmony_open(struct inode *inode, struct file *file)
 {
 	struct harmony_file *state;
