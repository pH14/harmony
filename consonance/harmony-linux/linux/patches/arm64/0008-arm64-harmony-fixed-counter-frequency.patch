arm64: make CNTFRQ a guest contract constant

The architected CNTFRQ_EL0 register is not virtualized to a common value by
the two supported substrates: the validated HVF host reports 24 MHz while the
validated KVM host reports 1 GHz. Linux copies that value into boot_cpu_data,
so treating CNTFRQ reads as harmless made otherwise identical M5 guest RAM
diverge before userspace.

The Harmony board already fixes the generic-timer input to 62.5 MHz in its DTB
and pvclock ABI. Under the dedicated HARMONY_ARM_PVCLOCK configuration, return
that contract value from the shared arm64 accessor instead of reading the host
register. The post-build scanner is tightened separately to reject any raw
CNTFRQ instruction that bypasses this accessor.

This patch is Linux-kernel code (GPL-2.0), carried as a diff under the Harmony
repository's designated guest-kernel patch exception.

---
--- a/arch/arm64/include/asm/arch_timer.h
+++ b/arch/arm64/include/asm/arch_timer.h
@@ -152,7 +152,13 @@ static __always_inline u64 __arch_counter_get_cntpct_stable(void)
 
+#define HARMONY_ARM_CNTFRQ_HZ 62500000U
 static inline u32 arch_timer_get_cntfrq(void)
 {
+#ifdef CONFIG_HARMONY_ARM_PVCLOCK
+	/* The Harmony DTB and pvclock ABI expose this exact guest frequency. */
+	return HARMONY_ARM_CNTFRQ_HZ;
+#else
 	return read_sysreg(cntfrq_el0);
+#endif
 }
 
 static inline u32 arch_timer_get_cntkctl(void)
--- a/arch/arm64/kernel/cpufeature.c
+++ b/arch/arm64/kernel/cpufeature.c
@@ -77,5 +77,6 @@
 #include <linux/sched/isolation.h>
 
+#include <asm/arch_timer.h>
 #include <asm/cpu.h>
 #include <asm/cpufeature.h>
 #include <asm/cpu_ops.h>
@@ -1571,7 +1572,13 @@ u64 __read_sysreg_by_encoding(u32 sys_id)
 	read_sysreg_case(SYS_ID_AA64ISAR2_EL1);
 	read_sysreg_case(SYS_ID_AA64ISAR3_EL1);
 
+#ifdef CONFIG_HARMONY_ARM_PVCLOCK
+	case SYS_CNTFRQ_EL0:
+		val = HARMONY_ARM_CNTFRQ_HZ;
+		break;
+#else
 	read_sysreg_case(SYS_CNTFRQ_EL0);
+#endif
 	read_sysreg_case(SYS_CTR_EL0);
 	read_sysreg_case(SYS_DCZID_EL0);
 
--- a/arch/arm64/kernel/cpuinfo.c
+++ b/arch/arm64/kernel/cpuinfo.c
@@ -472,7 +472,12 @@ static void __cpuinfo_store_cpu(struct cpuinfo_arm64 *info)
 	info->reg_ctr = read_cpuid_effective_cachetype();
 	info->reg_dczid = read_cpuid(DCZID_EL0);
 	info->reg_midr = read_cpuid_id();
+#ifdef CONFIG_HARMONY_ARM_PVCLOCK
+	info->reg_revidr = 0;
+	info->reg_aidr = 0;
+#else
 	info->reg_revidr = read_cpuid(REVIDR_EL1);
 	info->reg_aidr = read_cpuid(AIDR_EL1);
+#endif
 
 	info->reg_id_aa64dfr0 = read_cpuid(ID_AA64DFR0_EL1);
