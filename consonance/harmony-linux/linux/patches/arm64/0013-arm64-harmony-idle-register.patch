arm64: idle with one exit per wakeup

Patch 0007 rings the execution tick on every idle-poll pass, so an idle vCPU
reaches the next clockevent deadline only after about a hundred exits per
10 ms period. Under the cooperative Harmony clock configuration, the poll loop
instead writes a dedicated idle register. Userspace treats the write like a
WFI: it delivers a pending interrupt, or advances virtual time to the earlier
of the next deliverable deadline and the next host event, so each wakeup
costs one exit. The loop still re-checks need_resched after every write.

This patch is Linux-kernel code (GPL-2.0), carried as a diff under the Harmony
repository's designated guest-kernel patch exception.

---
--- a/arch/arm64/include/asm/arch_timer.h
+++ b/arch/arm64/include/asm/arch_timer.h
@@ -180,6 +180,7 @@ int harmony_arm_clockevent_set_next(unsigned long delta);
 void harmony_arm_clockevent_disarm(void);
 void harmony_arm_clockevent_ack(void);
 void harmony_arm_virtual_time_tick(void);
+void harmony_arm_idle(void);
 
 static __always_inline u64 __arch_counter_get_cntpct_stable(void)
 {
--- a/drivers/clocksource/harmony_arm_pvclock.c
+++ b/drivers/clocksource/harmony_arm_pvclock.c
@@ -35,6 +35,7 @@
 #define HARMONY_CLOCKEVENT_ACK		2U
 #define HARMONY_VIRTUAL_TIME_TICK	0x20
 #define HARMONY_IRQ_UNMASK_FENCE	0x24
+#define HARMONY_IDLE			0x28
 #define HARMONY_PVCLOCK_REGISTER_SPINS	(1U << 28) /* bounded deterministic handshake */
 #define HARMONY_PVCLOCK_ABI		1U
 #define HARMONY_FLAG_MATERIALIZED	(1U << 0)
@@ -224,3 +225,14 @@ void harmony_arm_irq_unmask_fence(void)
 		return;
 	writel(1, harmony_registers + HARMONY_IRQ_UNMASK_FENCE);
 }
+
+/*
+ * One idle exit lets userspace advance virtual time to the next deadline or
+ * host event instead of charging an execution tick for every idle-poll pass.
+ */
+void harmony_arm_idle(void)
+{
+	if (!harmony_registers)
+		return;
+	writel(1, harmony_registers + HARMONY_IDLE);
+}
--- a/kernel/sched/idle.c
+++ b/kernel/sched/idle.c
@@ -69,7 +69,7 @@ static noinline int __cpuidle cpu_idle_poll(void)
 	while (!tif_need_resched() &&
 	       (cpu_idle_force_poll || tick_check_broadcast_expired()))
 #ifdef CONFIG_HARMONY_ARM_PVCLOCK
-		harmony_arm_virtual_time_tick();
+		harmony_arm_idle();
 #else
 		cpu_relax();
 #endif
