arm64: map only identity-map code executable during early boot

The initial identity map marks all kernel read-only data executable until
final page tables take over. Only the code in .rodata.text requires that
early executable mapping. Give it page-bounded linker symbols, mark the
surrounding data NX, and reserve the page-table space for the extra splits.
The artifact scanner includes the special executable page in its proof.

--- a/arch/arm64/kernel/pi/map_range.c
+++ b/arch/arm64/kernel/pi/map_range.c
@@ -98,9 +98,21 @@
 	pgprot_val(data_prot) &= ~clrmask;
 
 	/* MMU is off; pointer casts to phys_addr_t are safe */
-	map_range(&ptep, (u64)_stext, (u64)__initdata_begin,
+	map_range(&ptep, (u64)_stext, (u64)_etext,
 		  (phys_addr_t)_stext, text_prot, IDMAP_ROOT_LEVEL,
 		  (pte_t *)pg_dir, false, 0);
+	map_range(&ptep, (u64)_etext, (u64)__rodata_text_begin,
+		  (phys_addr_t)_etext, data_prot, IDMAP_ROOT_LEVEL,
+		  (pte_t *)pg_dir, false, 0);
+	map_range(&ptep, (u64)__rodata_text_begin, (u64)__rodata_text_end,
+		  (phys_addr_t)__rodata_text_begin, text_prot, IDMAP_ROOT_LEVEL,
+		  (pte_t *)pg_dir, false, 0);
+	map_range(&ptep, (u64)__rodata_text_end, (u64)__inittext_begin,
+		  (phys_addr_t)__rodata_text_end, data_prot, IDMAP_ROOT_LEVEL,
+		  (pte_t *)pg_dir, false, 0);
+	map_range(&ptep, (u64)__inittext_begin, (u64)__initdata_begin,
+		  (phys_addr_t)__inittext_begin, text_prot, IDMAP_ROOT_LEVEL,
+		  (pte_t *)pg_dir, false, 0);
 	map_range(&ptep, (u64)__initdata_begin, (u64)_end,
 		  (phys_addr_t)__initdata_begin, data_prot, IDMAP_ROOT_LEVEL,
 		  (pte_t *)pg_dir, false, 0);
--- a/arch/arm64/include/asm/kernel-pgtable.h
+++ b/arch/arm64/include/asm/kernel-pgtable.h
@@ -75,12 +75,12 @@
  */
 #define EARLY_SEGMENT_EXTRA_PAGES (KERNEL_SEGMENT_COUNT + 2)
 /*
- * The initial ID map consists of the kernel image, mapped as two separate
- * segments, and may appear misaligned wrt the swapper block size. This means
- * we need 3 additional pages. The DT could straddle a swapper block boundary,
- * so it may need 2.
+ * The initial ID map consists of six segments: permanent text, read-only
+ * data, identity-map text, page-table data, init text, and later data. These
+ * segments may be misaligned wrt the swapper block size, so reserve seven
+ * additional pages. The DT could straddle a swapper block boundary and need two.
  */
-#define EARLY_IDMAP_EXTRA_PAGES		3
+#define EARLY_IDMAP_EXTRA_PAGES		7
 #define EARLY_IDMAP_EXTRA_FDT_PAGES	2
 #else
 #define EARLY_SEGMENT_EXTRA_PAGES	0
