+impl ResumableCall {
+    pub fn harmony_capture(&self) -> Result<HarmonyContinuation, Error> {
+        let (common, required_fuel, caller_result) = match self {
+            Self::HostTrap(trap) => (&trap.common, None, Some(i16::from(trap.caller_results.head()))),
+            Self::OutOfFuel(trap) => (&trap.common, Some(trap.required_fuel), None),
+            Self::Finished => return Err(Error::new("cannot snapshot a finished call")),
+        };
+        Ok(HarmonyContinuation { values: common.stack.values.harmony_capture(),
+            frames: common.stack.calls.harmony_capture(&common.engine.inner.code_map)?, required_fuel, caller_result })
+    }
+    pub unsafe fn harmony_restore(engine: Engine, instance: crate::Instance, root: Func, host: Func,
+        snapshot: &HarmonyContinuation) -> Result<Self, Error> {
+        let mut stack = Stack::new(engine.config().stack_limits());
+        stack.values.harmony_restore(&snapshot.values)?;
+        stack.calls.harmony_restore(&engine.inner.code_map, instance, &snapshot.frames, snapshot.values.len())?;
+        let common = ResumableCallCommon::new(engine, root, stack);
+        match (snapshot.required_fuel, snapshot.caller_result) {
+            (Some(required_fuel), None) => Ok(Self::OutOfFuel(ResumableCallOutOfFuel { common, required_fuel })),
+            (None, Some(result)) => Ok(Self::HostTrap(ResumableCallHostTrap { common, host_func: host,
+                host_error: Error::new("restored pending import"), caller_results: RegSpan::new(crate::ir::Reg::from(result)) })),
+            _ => Err(Error::new("bad continuation kind")),
+        }
+    }
