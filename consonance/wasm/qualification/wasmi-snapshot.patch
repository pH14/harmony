+impl CodeMap {
+    pub(crate) fn harmony_position(&self, instruction: &Instruction) -> Result<(u32, u32), Error> {
+        let address = instruction as *const Instruction as usize;
+        for (index, entity) in self.funcs.lock().iter() {
+            if let Some(cref) = entity.get_compiled() {
+                let instrs = cref.instrs();
+                let start = instrs.as_ptr() as usize;
+                let bytes = core::mem::size_of_val(instrs);
+                if address >= start && address < start + bytes {
+                    return Ok((index.0, ((address - start) / core::mem::size_of::<Instruction>()) as u32));
+                }
+            }
+        }
+        Err(Error::new("unknown snapshot instruction"))
+    }
+    pub(crate) fn harmony_instruction(&self, function: u32, offset: u32) -> Result<super::executor::InstructionPtr, Error> {
+        let guard = self.funcs.lock();
+        let cref = guard.get(EngineFunc(function)).and_then(FuncEntity::get_compiled)
+            .ok_or_else(|| Error::new("unknown snapshot function"))?;
+        let instructions = cref.instrs();
+        if offset as usize >= instructions.len() { return Err(Error::new("snapshot instruction exceeds function")); }
+        Ok(super::executor::InstructionPtr::new(instructions.as_ptr().wrapping_add(offset as usize)))
+    }
+}
