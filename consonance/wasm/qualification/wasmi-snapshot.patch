+impl Instance {
+    pub fn harmony_segment_lengths(&self, mut ctx: impl crate::AsContextMut) -> (alloc::vec::Vec<usize>, alloc::vec::Vec<u32>) {
+        let ctx = ctx.as_context_mut();
+        let entity = ctx.store.inner.resolve_instance(self);
+        let data = entity.data_segments.to_vec();
+        let elements = entity.elem_segments.to_vec();
+        (data.iter().map(|segment| ctx.store.inner.resolve_data_segment_mut(segment).bytes().len()).collect(),
+            elements.iter().map(|segment| ctx.store.inner.resolve_element_segment(segment).size()).collect())
+    }
+    pub fn harmony_restore_segments(&self, mut ctx: impl crate::AsContextMut, data: &[usize], elements: &[u32]) -> Result<(), crate::Error> {
+        let ctx = ctx.as_context_mut();
+        let entity = ctx.store.inner.resolve_instance(self);
+        let handles = entity.data_segments.to_vec();
+        let element_handles = entity.elem_segments.to_vec();
+        if handles.len() != data.len() || element_handles.len() != elements.len() { return Err(crate::Error::new("segment count mismatch")); }
+        for (handle, &length) in handles.iter().zip(data) {
+            let segment = ctx.store.inner.resolve_data_segment_mut(handle);
+            if length == 0 { segment.drop_bytes(); }
+            else if segment.bytes().len() != length { return Err(crate::Error::new("restore requires fresh data segments")); }
+        }
+        for (handle, &length) in element_handles.iter().zip(elements) {
+            let segment = ctx.store.inner.resolve_element_segment_mut(handle);
+            if length == 0 { segment.drop_items(); }
+            else if segment.size() != length { return Err(crate::Error::new("restore requires fresh element segments")); }
+        }
+        Ok(())
+    }
