+impl CodeMap {
+    pub(crate) fn harmony_frame_bounds(&self, function: u32, offset: u32, start: usize, base: usize, values: &[u64]) -> Result<(usize, usize), Error> {
+        let guard = self.funcs.lock();
+        let compiled = guard.get(EngineFunc(function)).and_then(FuncEntity::get_compiled).ok_or_else(|| Error::new("unknown continuation function"))?;
+        let constants = compiled.consts();
+        let end = start.checked_add(usize::from(compiled.len_registers())).filter(|end| *end <= values.len()).ok_or_else(|| Error::new("continuation frame exceeds value stack"))?;
+        if start.checked_add(constants.len()) != Some(base) || base > end { return Err(Error::new("continuation base does not match compiled constants")); }
+        if values[start..base].iter().zip(constants).any(|(bits, constant)| *bits != constant.to_bits64()) { return Err(Error::new("continuation changed an immutable constant")); }
+        let instruction = compiled.instrs().get(offset as usize).ok_or_else(|| Error::new("continuation position exceeds compiled function"))?;
+        use crate::ir::Instruction as I;
+        if matches!(instruction,
+            I::TableIndex { .. } | I::MemoryIndex { .. } | I::DataIndex { .. } | I::ElemIndex { .. }
+            | I::Const32 { .. } | I::I64Const32 { .. } | I::F64Const32 { .. }
+            | I::BranchTableTarget { .. } | I::BranchTableTargetNonOverlapping { .. }
+            | I::Register { .. } | I::Register2 { .. } | I::Register3 { .. }
+            | I::RegisterAndImm32 { .. } | I::Imm16AndImm32 { .. } | I::RegisterSpan { .. }
+            | I::RegisterList { .. } | I::CallIndirectParams { .. } | I::CallIndirectParamsImm16 { .. }) {
+            return Err(Error::new("continuation position names an instruction operand"));
+        }
+        Ok((end, end - base))
+    }
