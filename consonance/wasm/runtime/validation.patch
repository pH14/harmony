+impl ResumableCall {
+    pub fn harmony_validate<T>(engine: &Engine, ctx: impl crate::AsContext<Data = T>, instance: crate::Instance, root: Func, host: Func, snapshot: &HarmonyContinuation) -> Result<(), Error> {
+        let ctx = ctx.as_context();
+        let crate::func::FuncEntity::Wasm(root_body) = ctx.store.inner.resolve_func(&root) else { return Err(Error::new("continuation root is not a guest function")); };
+        if root_body.instance() != &instance { return Err(Error::new("continuation root belongs to another instance")); }
+        if snapshot.frames.is_empty() || snapshot.frames[0][0] != u64::from(root_body.func_body().harmony_index()) { return Err(Error::new("continuation root frame differs")); }
+        let results = root.ty(&ctx).results().len();
+        let functions = instance.harmony_function_results(&ctx);
+        let mut expected = results;
+        let mut parent_registers = results;
+        let mut top_registers = 0;
+        for (index, frame) in snapshot.frames.iter().enumerate() {
+            let function = u32::try_from(frame[0]).map_err(|_| Error::new("invalid continuation function"))?;
+            let offset = u32::try_from(frame[1]).map_err(|_| Error::new("invalid continuation position"))?;
+            let base = usize::try_from(frame[2]).map_err(|_| Error::new("invalid continuation base"))?;
+            let start = usize::try_from(frame[3]).map_err(|_| Error::new("invalid continuation frame"))?;
+            let output = usize::try_from(frame[4]).map_err(|_| Error::new("invalid continuation result"))?;
+            let count = *functions.get(&function).ok_or_else(|| Error::new("continuation function belongs to another module"))?;
+            if count > 1 || start != expected || output > i16::MAX as usize || (index == 0 && output != 0) || output.checked_add(count).is_none_or(|end| end > parent_registers) { return Err(Error::new("continuation frame allocation or result range differs")); }
+            let (end, registers) = engine.inner.code_map.harmony_frame_bounds(function, offset, start, base, &snapshot.values)?;
+            expected = end; parent_registers = registers; top_registers = registers;
+        }
+        if expected != snapshot.values.len() { return Err(Error::new("continuation has unowned value-stack entries")); }
+        match (snapshot.required_fuel, snapshot.caller_result) {
+            (Some(_), None) => {},
+            (None, Some(result)) if result >= 0 && (result as usize) < top_registers => {
+                if !matches!(host.ty(&ctx).results(), [crate::core::ValType::I32]) { return Err(Error::new("pending import must return one i32")); }
+            },
+            _ => return Err(Error::new("invalid continuation kind or pending result")),
+        }
+        Ok(())
+    }
+}
