+impl ResumableCall {
+    pub fn harmony_complete_i32<T>(&mut self, ctx: impl crate::AsContext<Data = T>, value: i32) -> Result<(), Error> {
+        let Self::HostTrap(trap) = self else { return Err(Error::new("no pending import")); };
+        trap.validate_inputs(ctx.as_context(), &[crate::Val::I32(value)])?;
+        let frame = trap.common.stack.calls.peek().ok_or_else(|| Error::new("pending import has no caller"))?;
+        trap.common.stack.values.harmony_write_i32(usize::from(frame.base_offset()), i16::from(trap.caller_results.head()), value)?;
+        let Self::HostTrap(trap) = core::mem::replace(self, Self::Finished) else { unreachable!() };
+        *self = Self::OutOfFuel(ResumableCallOutOfFuel { common: trap.common, required_fuel: 0 });
+        Ok(())
+    }
