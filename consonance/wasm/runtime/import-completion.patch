+impl ValueStack {
+    pub(crate) fn harmony_write_i32(&mut self, base: usize, register: i16, value: i32) -> Result<(), crate::Error> {
+        let register = usize::try_from(register).map_err(|_| crate::Error::new("import result is a constant register"))?;
+        let index = base.checked_add(register).ok_or_else(|| crate::Error::new("import result offset overflow"))?;
+        let target = self.values.get_mut(index).ok_or_else(|| crate::Error::new("import result exceeds value stack"))?;
+        *target = UntypedVal::from_bits64(u64::from(value as u32));
+        Ok(())
+    }
