From e963c601c4c91351a30a03531eb5a0c86772df5f Mon Sep 17 00:00:00 2001
From: harmony <harmony@box>
Date: Wed, 26 Aug 2026 06:45:30 -0400
Subject: [PATCH] KVM: x86: give the deterministic single-step its own class

Patch 0007 gated the MTF single-step on KVM_DETERMINISTIC_INTERCEPT_PREEMPT,
which SVM advertises.  KVM_ARM_MTF_STEP therefore succeeds on an AMD host and
sets mtf_step_armed, but only vmx.c reads that flag, so the step never happens
and KVM_RUN resumes the guest instead of advancing it one instruction.  A VMM
that trusts the ioctl either lands far past its target or, with the PMU
disarmed for the stepping phase, waits for an exit that never comes.

Split the single-step out as KVM_DETERMINISTIC_INTERCEPT_STEP, advertised by
VMX when the hardware has a monitor trap flag and never by SVM, so the arm
ioctl is refused where no vendor implements it.
---
 arch/x86/kvm/svm/svm.c          | 4 ++++
 arch/x86/kvm/vmx/capabilities.h | 5 +++++
 arch/x86/kvm/vmx/vmx.c          | 9 ++++++---
 arch/x86/kvm/x86.c              | 2 +-
 include/uapi/linux/kvm.h        | 1 +
 5 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/arch/x86/kvm/svm/svm.c b/arch/x86/kvm/svm/svm.c
index 64dd5e0cf..ebf90319e 100644
--- a/arch/x86/kvm/svm/svm.c
+++ b/arch/x86/kvm/svm/svm.c
@@ -5474,6 +5474,10 @@ static __init int svm_hardware_setup(void)
 	 * left out of the advertised set and a VMM asking for it is refused
 	 * rather than run without the coverage it asked for.  Guest randomness
 	 * has to be denied above the hypervisor on this vendor.
+	 *
+	 * The single-step class is left out for the same reason: SVM has no
+	 * monitor trap flag, so nothing here consumes mtf_step_armed and a VMM
+	 * must fall back to RFLAGS.TF via KVM_GUESTDBG_SINGLESTEP.
 	 */
 	kvm_caps.supported_deterministic_intercepts =
 		KVM_DETERMINISTIC_INTERCEPT_TSC |
diff --git a/arch/x86/kvm/vmx/capabilities.h b/arch/x86/kvm/vmx/capabilities.h
index 02aadb9d7..979120c45 100644
--- a/arch/x86/kvm/vmx/capabilities.h
+++ b/arch/x86/kvm/vmx/capabilities.h
@@ -114,6 +114,11 @@ static inline bool cpu_has_vmx_mpx(void)
 	return vmcs_config.vmentry_ctrl & VM_ENTRY_LOAD_BNDCFGS;
 }
 
+static inline bool cpu_has_vmx_monitor_trap_flag(void)
+{
+	return vmcs_config.cpu_based_exec_ctrl & CPU_BASED_MONITOR_TRAP_FLAG;
+}
+
 static inline bool cpu_has_vmx_tpr_shadow(void)
 {
 	return vmcs_config.cpu_based_exec_ctrl & CPU_BASED_TPR_SHADOW;
diff --git a/arch/x86/kvm/vmx/vmx.c b/arch/x86/kvm/vmx/vmx.c
index efdc4dfc7..50e881684 100644
--- a/arch/x86/kvm/vmx/vmx.c
+++ b/arch/x86/kvm/vmx/vmx.c
@@ -5935,7 +5935,7 @@ int vmx_vcpu_pre_run(struct kvm_vcpu *vcpu)
 
 	/* Deterministic single-step (harmony 0005): arm MTF for one instruction. */
 	if ((vcpu->kvm->arch.deterministic_intercepts &
-	     KVM_DETERMINISTIC_INTERCEPT_PREEMPT) && vcpu->arch.mtf_step_armed)
+	     KVM_DETERMINISTIC_INTERCEPT_STEP) && vcpu->arch.mtf_step_armed)
 		exec_controls_setbit(to_vmx(vcpu), CPU_BASED_MONITOR_TRAP_FLAG);
 
 	return 1;
@@ -5964,7 +5964,7 @@ static int handle_monitor_trap(struct kvm_vcpu *vcpu)
 {
 	/* Deterministic single-step (harmony 0005): MTF one-shot step. */
 	if ((vcpu->kvm->arch.deterministic_intercepts &
-	     KVM_DETERMINISTIC_INTERCEPT_PREEMPT) && vcpu->arch.mtf_step_armed) {
+	     KVM_DETERMINISTIC_INTERCEPT_STEP) && vcpu->arch.mtf_step_armed) {
 		vcpu->arch.mtf_step_armed = false;
 		exec_controls_clearbit(to_vmx(vcpu), CPU_BASED_MONITOR_TRAP_FLAG);
 		vcpu->run->exit_reason = KVM_EXIT_DET_STEP;
@@ -6723,7 +6723,7 @@ int vmx_handle_exit(struct kvm_vcpu *vcpu, fastpath_t exit_fastpath)
 	 * lands its DET_STEP correctly.
 	 */
 	if (ret <= 0 && (vcpu->kvm->arch.deterministic_intercepts &
-			 KVM_DETERMINISTIC_INTERCEPT_PREEMPT) &&
+			 KVM_DETERMINISTIC_INTERCEPT_STEP) &&
 	    vcpu->arch.mtf_step_armed &&
 	    vmx_get_exit_reason(vcpu).basic != EXIT_REASON_MONITOR_TRAP_FLAG) {
 		vcpu->arch.mtf_step_armed = false;
@@ -8663,6 +8663,9 @@ __init int vmx_hardware_setup(void)
 	if (cpu_has_vmx_rdrand() && cpu_has_vmx_rdseed())
 		kvm_caps.supported_deterministic_intercepts |=
 			KVM_DETERMINISTIC_INTERCEPT_RNG;
+	if (cpu_has_vmx_monitor_trap_flag())
+		kvm_caps.supported_deterministic_intercepts |=
+			KVM_DETERMINISTIC_INTERCEPT_STEP;
 
 	set_bit(0, vmx_vpid_bitmap); /* 0 is reserved for host */
 
diff --git a/arch/x86/kvm/x86.c b/arch/x86/kvm/x86.c
index b48e3a001..ebfe915ab 100644
--- a/arch/x86/kvm/x86.c
+++ b/arch/x86/kvm/x86.c
@@ -6439,7 +6439,7 @@ long kvm_arch_vcpu_ioctl(struct file *filp,
 		/* Deterministic single-step (harmony 0005): arm one-shot MTF step. */
 		r = -EINVAL;
 		if (vcpu->kvm->arch.deterministic_intercepts &
-		    KVM_DETERMINISTIC_INTERCEPT_PREEMPT) {
+		    KVM_DETERMINISTIC_INTERCEPT_STEP) {
 			vcpu->arch.mtf_step_armed = true;
 			r = 0;
 		}
diff --git a/include/uapi/linux/kvm.h b/include/uapi/linux/kvm.h
index a8bc2ebd1..c4720f6d3 100644
--- a/include/uapi/linux/kvm.h
+++ b/include/uapi/linux/kvm.h
@@ -997,6 +997,7 @@ struct kvm_enable_cap {
 #define KVM_DETERMINISTIC_INTERCEPT_TSC		(1ULL << 0)
 #define KVM_DETERMINISTIC_INTERCEPT_RNG		(1ULL << 1)
 #define KVM_DETERMINISTIC_INTERCEPT_PREEMPT	(1ULL << 2)
+#define KVM_DETERMINISTIC_INTERCEPT_STEP	(1ULL << 3)
 
 struct kvm_irq_routing_irqchip {
 	__u32 irqchip;
-- 
