{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/guard-issue-creation.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
