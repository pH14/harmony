+void wave_slope_point(void) {
+    switch (collision) {
+        case COL_SLOPE_RD45:
+            if ((temp_x & 15) + (temp_y & 15) >= 15) cube_data[currplayer] |= 1;
+            break;
+        case COL_SLOPE_LD45:
+            if ((temp_y & 15) >= (temp_x & 15)) cube_data[currplayer] |= 1;
+            break;
+        case COL_SLOPE_RU45:
+            if ((temp_y & 15) <= (temp_x & 15)) cube_data[currplayer] |= 1;
+            break;
+        case COL_SLOPE_LU45:
+            if ((temp_x & 15) + (temp_y & 15) <= 15) cube_data[currplayer] |= 1;
+            break;
+    }
+}
+
+void wave_slope_center(void) {
+    temp_x += 4;
+    if ((temp_x & 15) < 4) {
+        bg_collision_sub();
+        wave_slope_point();
+        temp_x -= 4;
+        bg_collision_sub();
+    } else {
+        wave_slope_point();
+        temp_x -= 4;
+    }
+}
