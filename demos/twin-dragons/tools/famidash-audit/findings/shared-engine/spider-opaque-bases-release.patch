diff --git a/SAUCE/functions/spider_bases.h b/SAUCE/functions/spider_bases.h
new file mode 100644
--- /dev/null
+++ b/SAUCE/functions/spider_bases.h
@@ -0,0 +1,50 @@
+CODE_BANK_PUSH("CODE_2")
+unsigned char spider_base_flags(void);
+unsigned char spider_base_meta;
+static unsigned char spider_base_direction, spider_base_slot, spider_base_old_flags[2];
+static unsigned char spider_base_new_flags, spider_base_new_phase;
+CODE_BANK_POP()
+CODE_BANK_PUSH("CODE")
+unsigned char spider_base_crossed(unsigned char old_flags, unsigned char old_phase,
+                                unsigned char new_flags, unsigned char new_phase,
+                                unsigned char down) {
+    if (old_phase == new_phase) return 0;
+    if (down) {
+        if (new_phase < old_phase) return (old_flags & 2) || ((new_flags & 1) && new_phase);
+        return (new_flags & 1) && old_phase == 0;
+    }
+    if (new_phase > old_phase) return (new_flags & 2) || ((old_flags & 1) && old_phase);
+    return (old_flags & 1) && new_phase == 0;
+}
+
+CODE_BANK_POP()
+CODE_BANK_PUSH("CODE_2")
+
+void spider_base_begin(void) {
+    storeWordSeparately(add_scroll_y(high_byte(currplayer_y) + (currplayer_mini ? (byte(16 - Generic.height) >> 1) : 0) + (spider_base_direction ? Generic.height : 0), scroll_y), temp_y, temp_room);
+    temp_x = tmp7;
+    bg_collision_sub();
+    __asm__("stx %v", spider_base_meta);
+    spider_base_old_flags[0] = collision ? spider_base_flags() : 0;
+    if (((tmp7 ^ tmp9) & 240) == 0) {
+        spider_base_old_flags[1] = spider_base_old_flags[0];
+        return;
+    }
+    temp_x = tmp9;
+    bg_collision_sub();
+    __asm__("stx %v", spider_base_meta);
+    spider_base_old_flags[1] = collision ? spider_base_flags() : 0;
+}
+unsigned char spider_base_step(void) {
+    spider_base_new_flags = collision ? spider_base_flags() : 0;
+    if (!(spider_base_new_flags | spider_base_old_flags[spider_base_slot])) return 0;
+    spider_base_new_phase = temp_y & 15;
+    if (spider_base_crossed(spider_base_old_flags[spider_base_slot], spider_base_new_phase ^ 8,
+                           spider_base_new_flags, spider_base_new_phase, spider_base_direction)) {
+        cube_data[currplayer] |= 1;
+        return 1;
+    }
+    spider_base_old_flags[spider_base_slot] = spider_base_new_flags;
+    return 0;
+}
+CODE_BANK_POP()
