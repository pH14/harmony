+static signed char m45_dx, m45_dy, m45_ox, m45_oy;
+static unsigned char m45_type;
+
+int m45_signed_product(signed char x, signed char y) {
+    static unsigned char ax, ay;
+    static unsigned int product;
+    ax = x; ay = y;
+    product = (unsigned int)ax * ay;
+    if (x < 0) product -= (unsigned int)ay << 8;
+    if (y < 0) product -= (unsigned int)ax << 8;
+    return (signed short)product;
+}
+
+unsigned char mini45_triangle_hit(void) {
+    static signed char x0, y0, x1, y1, x2, y2;
+    static int limit, endpoint, a, b, c;
+    if (m45_ox > (m45_dx > 0 ? m45_dx : 0) || m45_ox + 32 < (m45_dx < 0 ? m45_dx : 0) ||
+        m45_oy > (m45_dy > 0 ? m45_dy : 0) || m45_oy + 32 < (m45_dy < 0 ? m45_dy : 0)) return 0;
+    x0 = m45_ox; y0 = m45_oy;
+    x1 = m45_ox + 32; y1 = m45_oy + 32;
+    switch (m45_type) {
+        case COL_SLOPE_RD45:
+            limit = m45_ox + m45_oy + 32; endpoint = m45_dx + m45_dy;
+            if (limit > 0 && endpoint < limit) return 0;
+            x0 += 32; x2 = m45_ox; y2 = m45_oy + 32;
+            break;
+        case COL_SLOPE_LD45:
+            limit = m45_oy - m45_ox; endpoint = m45_dy - m45_dx;
+            if (limit > 0 && endpoint < limit) return 0;
+            x2 = m45_ox; y2 = m45_oy + 32;
+            break;
+        case COL_SLOPE_RU45:
+            limit = m45_oy - m45_ox; endpoint = m45_dy - m45_dx;
+            if (limit < 0 && endpoint > limit) return 0;
+            x2 = m45_ox + 32; y2 = m45_oy;
+            break;
+        case COL_SLOPE_LU45:
+            limit = m45_ox + m45_oy + 32; endpoint = m45_dx + m45_dy;
+            if (limit < 0 && endpoint > limit) return 0;
+            y1 = m45_oy; x2 = m45_ox; y2 = m45_oy + 32;
+            break;
+        default: return 0;
+    }
+    a = m45_signed_product(x0, m45_dy);
+    a -= m45_signed_product(y0, m45_dx);
+    if (!a) return 1;
+    b = m45_signed_product(x1, m45_dy);
+    b -= m45_signed_product(y1, m45_dx);
+    if (!b || (a < 0 && b > 0) || (a > 0 && b < 0)) return 1;
+    c = m45_signed_product(x2, m45_dy);
+    c -= m45_signed_product(y2, m45_dx);
+    return !c || (a < 0 && c > 0) || (a > 0 && c < 0);
+}
+
+void check_mini_wave45_tile(void) {
+    if (wrap_mode) return;
+    if ((ss_x & 240) == (ss_old_x & 240) && (ss_y & 240) == (ss_old_y & 240)) return;
+    m45_dx = ss_dx * 2; m45_dy = ss_dy * 2;
+    m45_type = ss_type; m45_ox = ss_origin_x * 2 - 1; m45_oy = ss_origin_y * 2 - 1;
+    if (mini45_triangle_hit()) cube_data[ss_player] |= 1;
+}
