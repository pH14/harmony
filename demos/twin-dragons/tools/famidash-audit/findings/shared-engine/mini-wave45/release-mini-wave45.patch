+CODE_BANK_PUSH("MINI_WAVE45_BANK")
+static signed char m45_dx, m45_dy, m45_ox, m45_oy;
+static unsigned char m45_type;
+
+int m45_signed_product(signed char x, signed char y) {
+    static unsigned char ax, ay;
+    static unsigned int product;
+    ax = x; ay = y;
+    product = (unsigned int)ax * ay;
+    if (x < 0) product -= (unsigned int)ay << 8;
+    if (y < 0) product -= (unsigned int)ax << 8;
+    return (signed short)product;
+}
+
+unsigned char mini45_triangle_hit(void) {
+    static signed char x0, y0, x1, y1, x2, y2;
+    static int limit, endpoint, a, b, c;
+    if (m45_ox > (m45_dx > 0 ? m45_dx : 0) || m45_ox + 32 < (m45_dx < 0 ? m45_dx : 0) ||
+        m45_oy > (m45_dy > 0 ? m45_dy : 0) || m45_oy + 32 < (m45_dy < 0 ? m45_dy : 0)) return 0;
+    x0 = m45_ox; y0 = m45_oy;
+    x1 = m45_ox + 32; y1 = m45_oy + 32;
+    switch (m45_type) {
+        case COL_SLOPE_RD45:
+            limit = m45_ox + m45_oy + 32; endpoint = m45_dx + m45_dy;
+            if (limit > 0 && endpoint < limit) return 0;
+            x0 += 32; x2 = m45_ox; y2 = m45_oy + 32;
+            break;
+        case COL_SLOPE_LD45:
+            limit = m45_oy - m45_ox; endpoint = m45_dy - m45_dx;
+            if (limit > 0 && endpoint < limit) return 0;
+            x2 = m45_ox; y2 = m45_oy + 32;
+            break;
+        case COL_SLOPE_RU45:
+            limit = m45_oy - m45_ox; endpoint = m45_dy - m45_dx;
+            if (limit < 0 && endpoint > limit) return 0;
+            x2 = m45_ox + 32; y2 = m45_oy;
+            break;
+        case COL_SLOPE_LU45:
+            limit = m45_ox + m45_oy + 32; endpoint = m45_dx + m45_dy;
+            if (limit < 0 && endpoint > limit) return 0;
+            y1 = m45_oy; x2 = m45_ox; y2 = m45_oy + 32;
+            break;
+        default: return 0;
+    }
+    a = m45_signed_product(x0, m45_dy);
+    a -= m45_signed_product(y0, m45_dx);
+    if (!a) return 1;
+    b = m45_signed_product(x1, m45_dy);
+    b -= m45_signed_product(y1, m45_dx);
+    if (!b || (a < 0 && b > 0) || (a > 0 && b < 0)) return 1;
+    c = m45_signed_product(x2, m45_dy);
+    c -= m45_signed_product(y2, m45_dx);
+    return !c || (a < 0 && c > 0) || (a > 0 && c < 0);
+}
+
+static signed char m45_motion_x, m45_motion_y, m45_tile_x, m45_tile_y;
+unsigned char m45_valid[2];
+static unsigned char m45_level[2], m45_prev_x[2], m45_prev_collision[2];
+static unsigned int m45_prev_y[2];
+static unsigned char m45_player, m45_x, m45_old_x, m45_saved_collision;
+static unsigned int m45_y, m45_old_y;
+static int m45_full_dy;
+static unsigned char m45_saved_y, m45_saved_room;
+static unsigned int m45_encoded_y;
+void m45_set_old_y(void) {
+    m45_encoded_y = m45_old_y;
+    temp_room = 0;
+    while (m45_encoded_y >= 240) { m45_encoded_y -= 240; ++temp_room; }
+    temp_y = m45_encoded_y;
+}
+
+void m45_test_tile(void) {
+    if (m45_type != COL_SLOPE_RD45 && m45_type != COL_SLOPE_LD45 &&
+        m45_type != COL_SLOPE_RU45 && m45_type != COL_SLOPE_LU45) return;
+    m45_dx = m45_motion_x * 2; m45_dy = m45_motion_y * 2;
+    m45_ox = m45_tile_x * 2 - 1; m45_oy = m45_tile_y * 2 - 1;
+    if (mini45_triangle_hit()) cube_data[m45_player] |= 1;
+}
+
+void check_mini_wave45(void) {
+    m45_player = currplayer;
+    m45_x = temp_x; m45_saved_y = temp_y; m45_saved_room = temp_room;
+    m45_y = temp_y + (unsigned int)temp_room * 240; m45_saved_collision = collision;
+    if ((cube_data[m45_player] & 1) || wrap_mode) {
+        m45_valid[m45_player] = 0;
+        return;
+    }
+    m45_old_x = m45_prev_x[m45_player]; m45_old_y = m45_prev_y[m45_player];
+    m45_motion_x = (signed char)(m45_x - m45_old_x);
+    m45_full_dy = m45_y - m45_old_y;
+    if (!m45_valid[m45_player] || m45_level[m45_player] != level ||
+        m45_motion_x < -16 || m45_motion_x > 16 || m45_full_dy < -16 || m45_full_dy > 16) {
+        m45_old_x = m45_x; m45_old_y = m45_y;
+        m45_motion_x = 0; m45_full_dy = 0;
+    }
+    m45_motion_y = m45_full_dy;
+    if (!m45_motion_x && !m45_motion_y) goto remember;
+    if ((m45_x & 240) == (m45_old_x & 240) && (m45_y & 240) == (m45_old_y & 240)) goto remember;
+    m45_type = m45_prev_collision[m45_player];
+    m45_tile_x = -(m45_old_x & 15); m45_tile_y = -(m45_old_y & 15);
+    m45_test_tile();
+    m45_type = m45_saved_collision;
+    m45_tile_x = m45_motion_x - (m45_x & 15); m45_tile_y = m45_motion_y - (m45_y & 15);
+    m45_test_tile();
+    if ((m45_x & 240) != (m45_old_x & 240) && (m45_y & 240) != (m45_old_y & 240)) {
+        temp_x = m45_old_x;
+        bg_collision_sub(); m45_type = collision;
+        m45_tile_x = -(m45_old_x & 15); m45_tile_y = m45_motion_y - (m45_y & 15);
+        m45_test_tile();
+        temp_x = m45_x; m45_set_old_y();
+        bg_collision_sub(); m45_type = collision;
+        m45_tile_x = m45_motion_x - (m45_x & 15); m45_tile_y = -(m45_old_y & 15);
+        m45_test_tile();
+    }
+    temp_x = m45_x; temp_y = m45_saved_y; temp_room = m45_saved_room; collision = m45_saved_collision;
+remember:
+    m45_prev_collision[m45_player] = m45_saved_collision;
+    m45_prev_x[m45_player] = m45_x; m45_prev_y[m45_player] = m45_y;
+    m45_level[m45_player] = level; m45_valid[m45_player] = 1;
+}
