diff --git a/LEVELS/test_split_cache.py b/LEVELS/test_split_cache.py
new file mode 100644
index 0000000..b965c7d
--- /dev/null
+++ b/LEVELS/test_split_cache.py
@@ -0,0 +1,60 @@
+"""Split cache entries must retain the continuation table context."""
+
+import contextlib
+import io
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+import export_levels
+
+
+class SplitCacheTests(unittest.TestCase):
+    def test_reordering_levels_rebuilds_embedded_continuation_ids(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            source, output = root / "source", root / "output"
+            source.mkdir()
+            (output / "EXPORTS" / "level").mkdir(parents=True)
+            for name in ("alpha", "beta"):
+                (source / f"{name}_.csv").write_text("0,1\n")
+            levels = {name: {"level": name, "spikeSet": "A", "blockSet": "A", "songID": "song_test"}
+                      for name in ("alpha", "beta")}
+            calls = []
+
+            def split(data, first_meta_ptr, sizes):
+                calls.append(first_meta_ptr)
+                return [bytes([0x7f, 0x7f, first_meta_ptr]), bytes([0xff])]
+
+            def run(names):
+                with contextlib.redirect_stdout(io.StringIO()):
+                    export_levels.export_bg(source, [levels[name] for name in names], output)
+
+            def marker(name):
+                return (output / "EXPORTS" / "level" / f"{name}.lz.0.bin").read_bytes()[-1]
+
+            with patch.object(export_levels.aart_lz, "compress", return_value=bytes(8192)), \
+                    patch.object(export_levels, "split_rle_data_into_compressed_banks", side_effect=split):
+                run(["alpha"])
+                self.assertEqual(marker("alpha"), 0)
+                run(["beta", "alpha"])
+                self.assertEqual(marker("alpha"), 1)
+                self.assertEqual(calls, [0, 0, 1])
+                run(["beta", "alpha"])
+                self.assertEqual(calls, [0, 0, 1], "unchanged order should reuse both chunks")
+                run(["alpha", "beta"])
+                self.assertEqual(marker("alpha"), 0)
+                self.assertEqual(marker("beta"), 1)
+                cache_path = output / "level_data_cache.json"
+                cache = json.loads(cache_path.read_text())
+                cache["alpha"].pop("split_first_meta_ptr", None)
+                cache_path.write_text(json.dumps(cache))
+                before = len(calls)
+                run(["alpha", "beta"])
+                self.assertEqual(len(calls), before + 1, "legacy caches need a fresh context")
+
+
+if __name__ == "__main__":
+    unittest.main()
