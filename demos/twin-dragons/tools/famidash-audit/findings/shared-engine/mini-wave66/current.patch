--- /dev/null
+++ b/SAUCE/functions/mini_wave66.h
@@ -0,0 +1,119 @@
+CODE_BANK_PUSH("MINI_WAVE66_BANK")
+static signed char mw_dx, mw_dy, mw_ox, mw_oy;
+static unsigned char mw_type;
+static const unsigned char mw_vertices[8][8] = {
+    {8,16, 16,0, 16,16, 16,16},
+    {0,0, 8,16, 0,16, 0,16},
+    {0,16, 8,0, 16,0, 16,16},
+    {0,0, 8,0, 16,16, 0,16},
+    {8,0, 16,0, 16,16, 16,16},
+    {0,0, 8,0, 0,16, 0,16},
+    {0,0, 16,0, 16,16, 8,16},
+    {0,0, 16,0, 8,16, 0,16}
+};
+
+int mw_signed_product(signed char x, signed char y) {
+    static unsigned char ax, ay;
+    static unsigned int product;
+    ax = x; ay = y;
+    product = (unsigned int)ax * ay;
+    if (x < 0) product -= (unsigned int)ay << 8;
+    if (y < 0) product -= (unsigned int)ax << 8;
+    return (signed short)product;
+}
+
+unsigned char mini66_polygon_hit(void) {
+    static unsigned char index, shape, positive, negative, count;
+    static signed char x, y, min_x, max_x;
+    static int limit, endpoint, side;
+    static const signed char diagonal_limit[8] = {-32,0,-16,16,-16,16,0,32};
+    switch (mw_type) {
+        case COL_SLOPE_RD66_TOP: shape = 0; break;
+        case COL_SLOPE_LD66_TOP: shape = 1; break;
+        case COL_SLOPE_RD66_BOT: shape = 2; break;
+        case COL_SLOPE_LD66_BOT: shape = 3; break;
+        case COL_SLOPE_RU66_TOP: shape = 4; break;
+        case COL_SLOPE_LU66_TOP: shape = 5; break;
+        case COL_SLOPE_RU66_BOT: shape = 6; break;
+        case COL_SLOPE_LU66_BOT: shape = 7; break;
+        default: return 0;
+    }
+    min_x = mw_ox + ((shape == 0 || shape == 4) ? 8 : 0);
+    max_x = mw_ox + ((shape == 1 || shape == 5) ? 8 : 16);
+    if (min_x > (mw_dx > 0 ? mw_dx : 0) || max_x < (mw_dx < 0 ? mw_dx : 0) ||
+        mw_oy > (mw_dy > 0 ? mw_dy : 0) || mw_oy + 16 < (mw_dy < 0 ? mw_dy : 0)) return 0;
+    limit = diagonal_limit[shape];
+    if (shape & 1) { limit += mw_ox * 2; endpoint = mw_dx * 2; }
+    else { limit -= mw_ox * 2; endpoint = -mw_dx * 2; }
+    if (shape & 4) { limit += mw_oy; endpoint += mw_dy; }
+    else { limit -= mw_oy; endpoint -= mw_dy; }
+    if (limit < 0 && endpoint > limit) return 0;
+    positive = negative = 0;
+    count = (shape & 2) ? 4 : 3;
+    for (index = 0; index < count; ++index) {
+        x = mw_ox + mw_vertices[shape][index * 2];
+        y = mw_oy + mw_vertices[shape][index * 2 + 1];
+        side = mw_signed_product(x, mw_dy);
+        side -= mw_signed_product(y, mw_dx);
+        if (side > 0) positive = 1;
+        else if (side < 0) negative = 1;
+        else return 1;
+        if (positive && negative) return 1;
+    }
+    return 0;
+}
+
+unsigned char mw_valid[2];
+static unsigned char mw_level[2], mw_prev_x[2], mw_prev_collision[2];
+static unsigned int mw_prev_y[2];
+static unsigned char mw_player, mw_x, mw_old_x, mw_saved_collision;
+static unsigned int mw_y, mw_old_y;
+static int mw_full_dy;
+
+void mw_test_tile(void) {
+    if (!((mw_type >= COL_SLOPE_RD66_TOP && mw_type <= COL_SLOPE_LD66_BOT) ||
+          (mw_type >= COL_SLOPE_RU66_TOP && mw_type <= COL_SLOPE_LU66_BOT))) return;
+    if (mini66_polygon_hit()) cube_data[mw_player] |= 1;
+}
+
+void check_mini_wave66(void) {
+    mw_player = currplayer;
+    mw_x = temp_x; mw_y = temp_y; mw_saved_collision = collision;
+    if ((cube_data[mw_player] & 1) || wrap_mode) {
+        mw_valid[mw_player] = 0;
+        return;
+    }
+    mw_old_x = mw_prev_x[mw_player]; mw_old_y = mw_prev_y[mw_player];
+    mw_dx = (signed char)(mw_x - mw_old_x);
+    mw_full_dy = mw_y - mw_old_y;
+    if (!mw_valid[mw_player] || mw_level[mw_player] != level ||
+        mw_dx < -16 || mw_dx > 16 || mw_full_dy < -16 || mw_full_dy > 16) {
+        mw_old_x = mw_x; mw_old_y = mw_y;
+        mw_dx = 0; mw_full_dy = 0;
+    }
+    mw_dy = mw_full_dy;
+    if (!mw_dx && !mw_dy) goto remember;
+    if ((mw_x & 240) == (mw_old_x & 240) && (mw_y & 240) == (mw_old_y & 240)) goto remember;
+    mw_type = mw_prev_collision[mw_player];
+    mw_ox = -(mw_old_x & 15); mw_oy = -(mw_old_y & 15);
+    mw_test_tile();
+    mw_type = mw_saved_collision;
+    mw_ox = mw_dx - (mw_x & 15); mw_oy = mw_dy - (mw_y & 15);
+    mw_test_tile();
+    if ((mw_x & 240) != (mw_old_x & 240) && (mw_y & 240) != (mw_old_y & 240)) {
+        temp_x = mw_old_x;
+        bg_collision_sub(); mw_type = collision;
+        mw_ox = -(mw_old_x & 15); mw_oy = mw_dy - (mw_y & 15);
+        mw_test_tile();
+        temp_x = mw_x; temp_y = mw_old_y;
+        bg_collision_sub(); mw_type = collision;
+        mw_ox = mw_dx - (mw_x & 15); mw_oy = -(mw_old_y & 15);
+        mw_test_tile();
+    }
+    temp_x = mw_x; temp_y = mw_y; collision = mw_saved_collision;
+remember:
+    mw_prev_collision[mw_player] = mw_saved_collision;
+    mw_prev_x[mw_player] = mw_x; mw_prev_y[mw_player] = mw_y;
+    mw_level[mw_player] = level; mw_valid[mw_player] = 1;
+}
+CODE_BANK_POP()
