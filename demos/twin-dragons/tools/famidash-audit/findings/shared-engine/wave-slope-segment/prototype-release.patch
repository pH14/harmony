+int wave_signed_product(signed char x, signed char y) {
+    static unsigned char ax, ay;
+    static unsigned int product;
+    ax = x; ay = y;
+    product = (unsigned int)ax * ay;
+    if (x < 0) product -= (unsigned int)ay << 8;
+    if (y < 0) product -= (unsigned int)ax << 8;
+    return (signed short)product;
+}
+
+unsigned char wave_triangle_hit(void) {
+    static signed char x0, y0, x1, y1, x2, y2;
+    static int a, b, c;
+    if (ss_origin_x > (ss_dx > 0 ? ss_dx : 0) || ss_origin_x + 16 < (ss_dx < 0 ? ss_dx : 0) ||
+        ss_origin_y > (ss_dy > 0 ? ss_dy : 0) || ss_origin_y + 16 < (ss_dy < 0 ? ss_dy : 0)) return 0;
+    x0 = ss_origin_x; y0 = ss_origin_y;
+    x1 = ss_origin_x + 16; y1 = ss_origin_y + 16;
+    switch (collision) {
+        case COL_SLOPE_RD45:
+            if (ss_origin_x + ss_origin_y + 16 > 0 && ss_origin_x + ss_origin_y + 16 > ss_dx + ss_dy) return 0;
+            x0 += 16; x2 = ss_origin_x; y2 = ss_origin_y + 16;
+            break;
+        case COL_SLOPE_LD45:
+            if (ss_origin_y - ss_origin_x > 0 && ss_origin_y - ss_origin_x > ss_dy - ss_dx) return 0;
+            x2 = ss_origin_x; y2 = ss_origin_y + 16;
+            break;
+        case COL_SLOPE_RU45:
+            if (ss_origin_y - ss_origin_x < 0 && ss_origin_y - ss_origin_x < ss_dy - ss_dx) return 0;
+            x2 = ss_origin_x + 16; y2 = ss_origin_y;
+            break;
+        case COL_SLOPE_LU45:
+            if (ss_origin_x + ss_origin_y + 16 < 0 && ss_origin_x + ss_origin_y + 16 < ss_dx + ss_dy) return 0;
+            x1 = ss_origin_x + 16; y1 = ss_origin_y; x2 = ss_origin_x; y2 = ss_origin_y + 16;
+            break;
+        default: return 0;
+    }
+    a = wave_signed_product(x0, ss_dy);
+    a -= wave_signed_product(y0, ss_dx);
+    b = wave_signed_product(x1, ss_dy);
+    b -= wave_signed_product(y1, ss_dx);
+    c = wave_signed_product(x2, ss_dy);
+    c -= wave_signed_product(y2, ss_dx);
+    return !((a > 0 && b > 0 && c > 0) || (a < 0 && b < 0 && c < 0));
+}
+
+void wave_test_slope_tile(void) {
+    if (collision != COL_SLOPE_RD45 && collision != COL_SLOPE_LD45 &&
+        collision != COL_SLOPE_RU45 && collision != COL_SLOPE_LU45) return;
+    if (wave_triangle_hit()) cube_data[ss_player] |= 1;
+}
+
+void check_wave_slope_segment(void) {
