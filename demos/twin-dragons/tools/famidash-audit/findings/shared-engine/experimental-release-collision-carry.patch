diff --git a/SAUCE/functions/pit_crossing.h b/SAUCE/functions/pit_crossing.h
new file mode 100644
index 0000000..f5186c8
--- /dev/null
+++ b/SAUCE/functions/pit_crossing.h
@@ -0,0 +1,87 @@
+CODE_BANK_PUSH("CODE")
+
+static unsigned char pit_x, pit_y, pit_room, pit_collision, pit_player, pit_delta;
+static unsigned char pit_previous_x[2], pit_previous_y[2], pit_previous_collision[2];
+unsigned char pit_previous_room[2];
+static unsigned char pit_old_x, pit_old, pit_current, pit_cross, pit_in_current;
+static unsigned char pit_low_y, pit_low_room, pit_high_x, pit_high_y;
+static signed char pit_dx;
+
+CODE_BANK_POP()
+#include "spike_sweep.h"
+CODE_BANK_PUSH("XCD_BANK_05")
+
+void check_pit_column(void) {
+    pit_dx = (signed char)(pit_high_x - pit_old_x);
+    if (pit_dx < -16 || pit_dx > 16) return;
+    pit_x = temp_x; pit_y = temp_y; pit_room = temp_room; pit_collision = collision;
+    temp_x = pit_high_x; temp_y = pit_low_y; temp_room = pit_low_room;
+    bg_collision_sub();
+    pit_current = collision == COL_PIT;
+    if (pit_current == pit_old) {
+        if (pit_old) cube_data[pit_player] |= 1;
+        goto restore;
+    }
+    pit_cross = pit_delta - (pit_high_y & 15);
+    if (pit_current) {
+        if (pit_dx > 0)
+            pit_in_current = (unsigned int)(unsigned char)pit_dx * pit_cross > (unsigned int)(16 - (pit_old_x & 15)) * pit_delta;
+        else
+            pit_in_current = (unsigned int)(unsigned char)-pit_dx * pit_cross > (unsigned int)(pit_old_x & 15) * pit_delta;
+    } else {
+        pit_cross--;
+        if (pit_dx > 0)
+            pit_in_current = (unsigned int)(unsigned char)pit_dx * pit_cross < (unsigned int)(16 - (pit_old_x & 15)) * pit_delta;
+        else
+            pit_in_current = (unsigned int)(unsigned char)-pit_dx * pit_cross <= (unsigned int)(pit_old_x & 15) * pit_delta;
+    }
+    if (pit_in_current) cube_data[pit_player] |= 1;
+restore:
+    temp_x = pit_x; temp_y = pit_y; temp_room = pit_room; collision = pit_collision;
+}
+
+void check_pit_motion(void) {
+    pit_player = currplayer;
+    if (temp_room > 3 || pit_previous_room[pit_player] > 3) return;
+    pit_delta = temp_y - pit_previous_y[pit_player];
+    pit_room = temp_room - pit_previous_room[pit_player];
+    if (pit_room == 1) pit_delta -= 16;
+    else if (pit_room == 255) pit_delta += 16;
+    else if (pit_room) return;
+    if (!pit_delta || (pit_delta > 16 && pit_delta < 240)) return;
+    if (wrap_mode || (cube_data[pit_player] & 1)) return;
+    if (!(pit_delta & 128)) {
+        pit_old = pit_previous_collision[pit_player] == COL_PIT;
+        pit_old_x = pit_previous_x[pit_player];
+        pit_low_y = pit_previous_y[pit_player]; pit_low_room = pit_previous_room[pit_player];
+        pit_high_x = temp_x; pit_high_y = temp_y;
+    } else {
+        pit_delta = -pit_delta;
+        pit_old = collision == COL_PIT; pit_old_x = temp_x;
+        pit_low_y = temp_y; pit_low_room = temp_room;
+        pit_high_x = pit_previous_x[pit_player]; pit_high_y = pit_previous_y[pit_player];
+    }
+    if ((pit_high_y & 15) >= pit_delta) return;
+    if ((pit_high_x & 240) == (pit_old_x & 240)) {
+        if (pit_old) cube_data[pit_player] |= 1;
+    } else check_pit_column();
+}
+
+CODE_BANK_POP()
+CODE_BANK_PUSH("CODE")
+
+void check_pit_crossing(void) {
+    __asm__("ldx %v\n lda %v\n ora %v,x\n beq %g", currplayer, collision, pit_previous_collision, empty);
+    __asm__("ldy %v\n lda %v,y\n bne %g\n ldy %v,x\n lda %v,y\n bne %g", collision, ss_shapes, query, pit_previous_collision, ss_shapes, query);
+empty:
+    __asm__("lda %v\n eor %v,x\n and #$f0\n beq %g", temp_x, pit_previous_x, remember);
+    __asm__("lda %v\n eor %v,x\n and #$f0\n beq %g", temp_y, pit_previous_y, remember);
+query:
+    crossPRGBankJump0(check_spike_motion);
+remember:
+    __asm__("ldx %v\n lda %v\n sta %v,x\n lda %v\n sta %v,x", currplayer,
+        temp_y, pit_previous_y, temp_room, pit_previous_room);
+    __asm__("lda %v\n sta %v,x\n lda %v\n sta %v,x", temp_x, pit_previous_x, collision, pit_previous_collision);
+}
+
+CODE_BANK_POP()
