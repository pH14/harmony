diff --git a/SAUCE/functions/base_crossing.h b/SAUCE/functions/base_crossing.h
new file mode 100644
index 0000000..ce08cfe
--- /dev/null
+++ b/SAUCE/functions/base_crossing.h
@@ -0,0 +1,75 @@
+#define BASE_METADATA 1
+CODE_BANK_PUSH("CODE")
+static unsigned char ss_base_open, ss_base_axis, ss_base_remaining;
+extern const unsigned char metatiles_bases[128];
+static unsigned int ss_base_lhs, ss_base_rhs;
+CODE_BANK_POP()
+CODE_BANK_PUSH("COLLISION_BANK")
+
+unsigned char ss_base_clip(void) {
+    if (ss_x0 > (signed char)ss_abs_dx || ss_x1 < 0 || ss_y0 > (signed char)ss_abs_dy || ss_y1 < 0) return 0;
+    if ((ss_x0 == (signed char)ss_abs_dx && (ss_base_open & 1)) ||
+        (!ss_x1 && (ss_base_open & 2)) ||
+        (ss_y0 == (signed char)ss_abs_dy && (ss_base_open & 4)) ||
+        (!ss_y1 && (ss_base_open & 8))) return 0;
+    if (!ss_abs_dx || !ss_abs_dy) return 1;
+    if (ss_x0 >= 0 && ss_y1 <= (signed char)ss_abs_dy) {
+        ss_base_lhs = (unsigned int)(unsigned char)ss_x0 * ss_abs_dy;
+        ss_base_rhs = (unsigned int)(unsigned char)ss_y1 * ss_abs_dx;
+        if (ss_base_lhs > ss_base_rhs || (ss_base_lhs == ss_base_rhs && (ss_base_open & 9))) return 0;
+    }
+    if (ss_y0 >= 0 && ss_x1 <= (signed char)ss_abs_dx) {
+        ss_base_lhs = (unsigned int)(unsigned char)ss_y0 * ss_abs_dx;
+        ss_base_rhs = (unsigned int)(unsigned char)ss_x1 * ss_abs_dy;
+        if (ss_base_lhs > ss_base_rhs || (ss_base_lhs == ss_base_rhs && (ss_base_open & 6))) return 0;
+    }
+    return 1;
+}
+
+CODE_BANK_POP()
+CODE_BANK_PUSH("COLLISION_BANK")
+
+unsigned char ss_base_hit(void) {
+    if (ss_base_axis < 2) {
+        ss_x0 = ss_origin_x; ss_x1 = ss_x0 + 16;
+        ss_y0 = ss_origin_y + (ss_base_axis ? 15 : 0);
+        ss_y1 = ss_y0 + 1;
+        if (!((ss_y0 >= 0 && ss_dy >= ss_y1) || (ss_y1 <= 0 && ss_dy <= ss_y0))) return 0;
+    } else {
+        ss_y0 = ss_origin_y; ss_y1 = ss_y0 + 16;
+        ss_x0 = ss_origin_x + (ss_base_axis == 3 ? 15 : 0);
+        ss_x1 = ss_x0 + 1;
+        if (!((ss_x0 >= 0 && ss_dx >= ss_x1) || (ss_x1 <= 0 && ss_dx <= ss_x0))) return 0;
+    }
+    ss_base_open = 10;
+    ss_abs_dx = ss_dx;
+    if (ss_dx < 0) {
+        ss_abs_dx = -ss_dx;
+        ss_swap = ss_x0; ss_x0 = -ss_x1; ss_x1 = -ss_swap;
+        ss_base_open ^= 3;
+    }
+    ss_abs_dy = ss_dy;
+    if (ss_dy < 0) {
+        ss_abs_dy = -ss_dy;
+        ss_swap = ss_y0; ss_y0 = -ss_y1; ss_y1 = -ss_swap;
+        ss_base_open ^= 12;
+    }
+    return ss_base_clip();
+}
+
+void ss_test_base(void) {
+    ss_base_axis = 0;
+    while (ss_base_remaining) {
+        if ((ss_base_remaining & 1) && ss_base_hit()) {
+#ifdef __CC65__
+            __asm__("ldx %v\n lda %v,x\n ora #1\n sta %v,x", ss_player, cube_data, cube_data);
+#else
+            cube_data[ss_player] |= 1;
+#endif
+            return;
+        }
+        ss_base_remaining >>= 1;
+        ++ss_base_axis;
+    }
+}
+CODE_BANK_POP()
diff --git a/SAUCE/functions/checked_motion.h b/SAUCE/functions/checked_motion.h
