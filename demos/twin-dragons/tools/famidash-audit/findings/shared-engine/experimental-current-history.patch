@@ -0,0 +1,60 @@
+CODE_BANK_PUSH("CODE_2")
+
+static unsigned char checked_y_delta;
+
+void checked_y_error(void) {
+    if (!wrap_mode && !DEBUG_MODE && !invincible_counter && high_byte(currplayer_relx) > 0x20) {
+        checked_y_fault = 1;
+        high_byte(currplayer_rely) = (high_byte(currplayer_rely) & 0x80) ? 6 : 0xe0;
+        cube_data[currplayer] |= 1;
+    }
+}
+
+
+CODE_BANK_POP()
+CODE_BANK_PUSH("CODE_2")
+
+void add_velocity_y_checked(void) {
+    __asm__("lda %v\n clc\n adc %v\n sta %v\n lda %v+1\n adc %v+1\n sta %v+1",
+        currplayer_vel_y, currplayer_rely, currplayer_rely, currplayer_vel_y, currplayer_rely, currplayer_rely);
+    __asm__("lda %v+1\n ror\n eor %v+1\n bpl %g\n jsr %v", currplayer_vel_y, currplayer_vel_y, done, checked_y_error);
+done:;
+}
+
+void subtract_velocity_y_checked(void) {
+    __asm__("lda %v\n sec\n sbc %v\n sta %v\n lda %v+1\n sbc %v+1\n sta %v+1",
+        currplayer_rely, currplayer_vel_y, currplayer_rely, currplayer_rely, currplayer_vel_y, currplayer_rely);
+    __asm__("lda %v+1\n ror\n eor %v+1\n bmi %g\n jsr %v", currplayer_vel_y, currplayer_vel_y, done, checked_y_error);
+done:;
+}
+
+void correct_y_from_a(void) {
+    __asm__("sta %v\n clc\n adc %v+1\n sta %v+1\n lda %v\n ror\n eor %v\n bpl %g\n jsr %v",
+        checked_y_delta, currplayer_rely, currplayer_rely, checked_y_delta, checked_y_delta, done, checked_y_error);
+done:;
+}
+
+CODE_BANK_POP()
+
+CODE_BANK_PUSH("CODE_2")
+void reset_invincible_collision_history(void) {
+    checked_y_fault = 0;
+    reset_collision_history();
+}
+CODE_BANK_POP()
+
+#define CORRECT_Y_HIGH(amount) do { __A__ = (amount); correct_y_from_a(); } while (0)
+#define EJECT_DOWN_CHECKED(done) CORRECT_Y_HIGH(0 - eject_D)
+
+#if LEVELSET == 'D'
+CODE_BANK_PUSH("CODE_2")
+#else
+CODE_BANK_PUSH("CODE")
+#endif
+void enforce_checked_y_fault(void) {
+    if (!checked_y_fault) return;
+    if (DEBUG_MODE || invincible_counter) checked_y_fault = 0;
+    else cube_data[currplayer] |= 1;
+}
+
+CODE_BANK_POP()
