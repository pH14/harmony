+++ b/tools/antithesis-go-toolexec/harmony_init_order_test.go
@@ -0,0 +1,19 @@
+package main
+
+import (
+	"slices"
+	"testing"
+)
+
+func TestHarmonyRegistrationPrecedesSources(t *testing.T) {
+	args := []string{"-p", "example", "-importcfg", "cfg", "-pack", "a.go", "b.go"}
+	pkg := &Package{ImportCfg: 3, GoFiles: []fileArg{{Index: 5, Path: "a.go"}, {Index: 6, Path: "b.go"}}}
+	got := insertBeforeSources(args, pkg, "antithesis_module.go")
+	want := []string{"-p", "example", "-importcfg", "cfg", "-pack", "antithesis_module.go", "a.go", "b.go"}
+	if !slices.Equal(got, want) {
+		t.Fatalf("got %v, want %v", got, want)
+	}
+	if got[pkg.ImportCfg] != "cfg" {
+		t.Fatalf("importcfg index %d points at %q", pkg.ImportCfg, got[pkg.ImportCfg])
+	}
+}
