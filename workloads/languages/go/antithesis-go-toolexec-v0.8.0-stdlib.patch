+// insertBeforeSources places the registration ahead of the package's own files.
+// Go initializes package-level variables in file order unless it sees a
+// dependency, and it cannot see one through an interface call made by another
+// package, so the handle must be declared first.
+func insertBeforeSources(args []string, pkg *Package, registration string) []string {
+	at := pkg.GoFiles[0].Index
+	for _, file := range pkg.GoFiles {
+		at = min(at, file.Index)
+	}
+	if pkg.ImportCfg >= at {
+		pkg.ImportCfg++
+	}
+	return slices.Insert(args, at, registration)
+}
