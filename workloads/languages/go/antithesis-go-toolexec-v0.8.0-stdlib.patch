+package main
+
+import "testing"
+
+func TestHarmonyStdPackageAllowlist(t *testing.T) {
+	cfg := &Config{Instrument: []string{"net", "runtime"}}
+	args := []string{"-std", "-importcfg", "unused", "/go/src/net/http/client.go"}
+	t.Setenv("TOOLEXEC_IMPORTPATH", "net/http")
+	if _, selected := selectedPackage(cfg, args); selected {
+		t.Fatal("standard library selected without explicit opt-in")
+	}
+	cfg.StdlibPackages = []string{"net/http", "runtime"}
+	if _, selected := selectedPackage(cfg, args); !selected {
+		t.Fatal("explicitly allowed standard library package skipped")
+	}
+	t.Setenv("TOOLEXEC_IMPORTPATH", "runtime")
+	if _, selected := selectedPackage(cfg, args); selected {
+		t.Fatal("runtime package selected")
+	}
+	cfg.Instrument = []string{sdkInstrumentationPackage}
+	cfg.StdlibPackages = []string{sdkInstrumentationPackage}
+	t.Setenv("TOOLEXEC_IMPORTPATH", sdkInstrumentationPackage)
+	if _, selected := selectedPackage(cfg, args); selected {
+		t.Fatal("SDK package selected")
+	}
+}
+
+func TestHarmonyStdPackageCacheIdentity(t *testing.T) {
+	cfg := &Config{}
+	before, err := cfg.ToolIDSuffix()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg.StdlibPackages = []string{"net/http"}
+	after, err := cfg.ToolIDSuffix()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if before == after {
+		t.Fatal("stdlib selection did not change the action cache key")
+	}
+}
