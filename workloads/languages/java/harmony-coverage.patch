+++ b/src/java.base/share/classes/java/lang/HarmonyCoverage.java
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
+package java.lang;
+
+/**
+ * Coverage callbacks for Java code running under Harmony. Every Java loop must
+ * reach libvoidstar, so that a thread spinning in compiled code still exits to
+ * the VM and advances virtual time.
+ */
+public final class HarmonyCoverage {
+    private HarmonyCoverage() {
+    }
+
+    /**
+     * Counts one back-edge. Rewritten class files call this before every
+     * backward jump.
+     */
+    public static void tick() {
+        Thread thread = Thread.currentCarrierThread();
+        if (thread != null && --thread.harmonyCoverageRemaining <= 0) {
+            long next = add(thread.harmonyCoverageBatch - thread.harmonyCoverageRemaining);
+            thread.harmonyCoverageBatch = next;
+            thread.harmonyCoverageRemaining = next;
+        }
+    }
+
+    private static native long add(long hits);
+}
