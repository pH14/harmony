diff --git a/src/java.base/share/classes/jdk/internal/misc/HarmonyRewriter.java b/src/java.base/share/classes/jdk/internal/misc/HarmonyRewriter.java
new file mode 100644
index 000000000..f06fd38ae
--- /dev/null
+++ b/src/java.base/share/classes/jdk/internal/misc/HarmonyRewriter.java
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
+package jdk.internal.misc;
+
+import java.io.IOException;
+import java.nio.file.DirectoryStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import jdk.internal.org.objectweb.asm.ClassReader;
+import jdk.internal.org.objectweb.asm.ClassVisitor;
+import jdk.internal.org.objectweb.asm.ClassWriter;
+import jdk.internal.org.objectweb.asm.Label;
+import jdk.internal.org.objectweb.asm.MethodVisitor;
+import jdk.internal.org.objectweb.asm.Opcodes;
+
+public final class HarmonyRewriter {
+    private static final String TICK_OWNER = "java/lang/HarmonyCoverage";
+
+    private HarmonyRewriter() {
+    }
+
+    public static byte[] rewrite(byte[] bytes, int offset, int length) {
+        if (bytes == null || offset < 0 || length < 0 || offset > bytes.length - length) {
+            return null;
+        }
+        try {
+            byte[] original = Arrays.copyOfRange(bytes, offset, offset + length);
+            if (!framed(original)) {
+                return null;
+            }
+            return rewriteStrict(original, 0, original.length, new long[1]);
+        } catch (RuntimeException | LinkageError e) {
+            return null;
+        }
+    }
+
+    private static boolean framed(byte[] bytes) {
+        ClassReader reader = new ClassReader(bytes);
+        if (reader.readInt(0) != 0xCAFEBABE) {
+            return false;
+        }
+        long at = reader.header + 6;
+        at += 2 + 2L * reader.readUnsignedShort((int) at);
+        for (int kind = 0; kind < 2; kind++) {
+            int count = reader.readUnsignedShort((int) at);
+            at += 2;
+            for (int member = 0; member < count; member++) {
+                at = skipAttributes(reader, at + 6, bytes.length);
+            }
+        }
+        return skipAttributes(reader, at, bytes.length) == bytes.length;
+    }
+
+    private static long skipAttributes(ClassReader reader, long at, int end) {
+        int count = reader.readUnsignedShort((int) at);
+        at += 2;
+        for (int attribute = 0; attribute < count; attribute++) {
+            at += 6 + (reader.readInt((int) at + 2) & 0xffffffffL);
+            if (at > end) {
+                throw new IllegalArgumentException();
+            }
+        }
+        return at;
+    }
+
+    private static byte[] rewriteStrict(byte[] bytes, int offset, int length, long[] sites) {
+        ClassReader reader = new ClassReader(bytes, offset, length);
+        String name = reader.getClassName();
+        if (name.equals("module-info") || name.equals(TICK_OWNER)) {
+            return null;
+        }
+        long before = sites[0];
+        ClassWriter writer = new ClassWriter(reader, 0);
+        reader.accept(new Methods(writer, sites), 0);
+        return sites[0] == before ? null : writer.toByteArray();
+    }
+
+    public static void main(String[] args) throws IOException {
+        long[] sites = new long[1];
+        long classes = 0;
+        for (String argument : args) {
+            List<Path> files = new ArrayList<>();
+            collect(Path.of(argument), files);
+            Collections.sort(files);
+            for (Path file : files) {
+                byte[] original = Files.readAllBytes(file);
+                byte[] rewritten = rewriteStrict(original, 0, original.length, sites);
+                if (rewritten != null) {
+                    Files.write(file, rewritten);
+                    classes++;
+                }
+            }
+        }
+        System.out.println("rewrote " + classes + " classes, " + sites[0] + " back-edges");
+    }
+
+    private static void collect(Path path, List<Path> files) throws IOException {
+        if (Files.isDirectory(path)) {
+            try (DirectoryStream<Path> entries = Files.newDirectoryStream(path)) {
+                for (Path entry : entries) {
+                    collect(entry, files);
+                }
+            }
+        } else if (path.toString().endsWith(".class")) {
+            files.add(path);
+        }
+    }
+
+    private static final class Methods extends ClassVisitor {
+        private final long[] sites;
+
+        Methods(ClassVisitor next, long[] sites) {
+            super(Opcodes.ASM9, next);
+            this.sites = sites;
+        }
+
+        @Override
+        public MethodVisitor visitMethod(int access, String method, String descriptor, String signature,
+                String[] exceptions) {
+            return new BackEdges(super.visitMethod(access, method, descriptor, signature, exceptions), sites);
+        }
+    }
+
+    private static final class BackEdges extends MethodVisitor {
+        private final Set<Label> seen = new HashSet<>();
+        private final long[] sites;
+
+        BackEdges(MethodVisitor next, long[] sites) {
+            super(Opcodes.ASM9, next);
+            this.sites = sites;
+        }
+
+        private void tick() {
+            sites[0]++;
+            super.visitMethodInsn(Opcodes.INVOKESTATIC, TICK_OWNER, "tick", "()V", false);
+        }
+
+        @Override
+        public void visitLabel(Label label) {
+            seen.add(label);
+            super.visitLabel(label);
+        }
+
+        @Override
+        public void visitJumpInsn(int opcode, Label label) {
+            if (seen.contains(label)) {
+                tick();
+            }
+            super.visitJumpInsn(opcode, label);
+        }
+
+        @Override
+        public void visitTableSwitchInsn(int min, int max, Label fallback, Label... labels) {
+            if (backward(fallback, labels)) {
+                tick();
+            }
+            super.visitTableSwitchInsn(min, max, fallback, labels);
+        }
+
+        @Override
+        public void visitLookupSwitchInsn(Label fallback, int[] keys, Label[] labels) {
+            if (backward(fallback, labels)) {
+                tick();
+            }
+            super.visitLookupSwitchInsn(fallback, keys, labels);
+        }
+
+        private boolean backward(Label fallback, Label[] labels) {
+            if (seen.contains(fallback)) {
+                return true;
+            }
+            for (Label label : labels) {
+                if (seen.contains(label)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+    }
+}
