{
  "format": "harmony-historical-case-v1",
  "id": "postgres-14.4-control",
  "title": "PostgreSQL 14.4 general workload, fixed-release control",
  "software": "PostgreSQL",
  "panel": "discovery",
  "sources": {
    "release_note": "https://www.postgresql.org/docs/release/14.4/"
  },
  "versions": {
    "fixed": "14.4"
  },
  "workload": {
    "version": "14.4",
    "source_url": "https://ftp.postgresql.org/pub/source/v14.4/postgresql-14.4.tar.bz2",
    "sha256": "c23b6237c5231c791511bdc79098617d6852e9e3bdf360efd8b5d15a1a3d8f6a"
  },
  "image": {
    "context": ".",
    "dockerfile": "workloads/bugs/historical/postgres-index-general/image/Dockerfile",
    "build_args": {
      "PG_VERSION": "14.4",
      "PG_SHA256": "c23b6237c5231c791511bdc79098617d6852e9e3bdf360efd8b5d15a1a3d8f6a"
    }
  },
  "kernel_profile": "faultlab",
  "oracle": {
    "assertion": "postgres amcheck finds every heap tuple indexed",
    "evidence": "postgres amcheck verified an index",
    "kind": "always",
    "source": "the general driver's check operation",
    "detector": "bt_index_check(index, heapallindexed => true) on every valid B-tree index of items",
    "fires_on": "amcheck raises data_corrupted (XX001) or index_corrupted (XX002)",
    "silent_when": [
      "the server is down",
      "the connection drops mid-check",
      "an index is dropped while it is checked"
    ],
    "integrity": [
      {
        "assertion": "postgres index and sequential scans agree",
        "evidence": "postgres general compared committed rows"
      },
      {
        "assertion": "postgres preserves acknowledged commits",
        "evidence": "postgres general compared committed rows"
      }
    ]
  },
  "actions": [
    "Wait",
    "Kill",
    "EventKill",
    "EventPark",
    "Pause",
    "Restart"
  ],
  "run": {
    "ram_mib": 1024,
    "knobs": {}
  },
  "search": {
    "executions": 1000000,
    "wall_minutes": 90
  },
  "discovery_mode": "control",
  "status": "new",
  "ci": {
    "status": "runnable",
    "display_name": "PostgreSQL 14.4 Control",
    "image_prefix": "pg-general"
  },
  "controls": [
    "postgres-index-general",
    "postgres-14.1-heldout"
  ]
}
