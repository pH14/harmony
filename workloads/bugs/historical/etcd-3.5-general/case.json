{
  "format": "harmony-historical-case-v1",
  "id": "etcd-3.5-general",
  "title": "etcd 3.5.2 key-value workload for general discovery",
  "software": "etcd",
  "panel": "discovery",
  "focused_case": "etcd-3.5-inconsistency",
  "sources": {
    "issue": "https://github.com/etcd-io/etcd/issues/13766",
    "fix_commit": "https://github.com/etcd-io/etcd/pull/13854",
    "postmortem": "https://github.com/etcd-io/etcd/blob/main/Documentation/postmortems/v3.5-data-inconsistency.md"
  },
  "versions": {
    "affected": "3.5.0-3.5.2",
    "fixed": "3.5.3"
  },
  "workload": {
    "version": "3.5.2",
    "source_sha256": "ecb4d2bc76e48ae504d9a00b50bcc906503c4d0324acf9dee79d97d16f7282ad"
  },
  "image": {
    "context": ".",
    "dockerfile": "workloads/bugs/historical/etcd-3.5-general/image/Dockerfile",
    "build_args": {
      "ETCD_VERSION": "3.5.2",
      "ETCD_SOURCE_SHA256": "ecb4d2bc76e48ae504d9a00b50bcc906503c4d0324acf9dee79d97d16f7282ad"
    }
  },
  "instrumentation": {
    "tool": "github.com/antithesishq/antithesis-sdk-go/tools/antithesis-go-toolexec",
    "version": "0.8.0",
    "license": "MIT"
  },
  "kernel_profile": "faultlab",
  "oracle": {
    "assertion": "every etcd member holds an acknowledged history",
    "evidence": "etcd general check compared the members that answered",
    "kind": "always",
    "source": "the general checker run as the bundle's continuous check",
    "journal_format": "I <op> <kind> <key> <value> | A <op> <revision> <applied> | F <op>",
    "detector": "serializable reads of gen/ from every member against the clients' journals",
    "fires_on": "a member's owned key at read revision R is not explained by the last acknowledged write at or below R or by an indeterminate write",
    "silent_when": [
      "a member is down",
      "a member read fails",
      "a journal cannot be read"
    ]
  },
  "actions": [
    "Wait",
    "Kill",
    "EventKill",
    "EventPark",
    "Pause",
    "Restart"
  ],
  "run": {
    "ram_mib": 1024,
    "knobs": {}
  },
  "search": {
    "executions": 1000000,
    "wall_minutes": 90
  },
  "discovery_mode": "general",
  "status": "measured",
  "ci": {
    "status": "runnable",
    "display_name": "etcd General",
    "image_prefix": "etcd-general"
  }
}
