@@ -174,3 +189,3 @@ func instrumentCoverage(cfg *Config, pkg *Package, args []string, paths []string
-// Declaring it as a package-level variable orders initialization correctly.
-// Go's dependency analysis ensures that the SDK and this variable are initialized
-// before any variable in the package whose initializer calls instrumented code.
+// The caller presents this file to the compiler before the package's existing
+// source files so the handle is initialized before an independent package variable
+// initializer can call instrumented code.
