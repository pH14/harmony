+//  2. generated files are added (a coverage registration, a catalog); and
@@ -40,0 +41,12 @@ func rewriteCompile(cfg *Config, pkg *Package, args []string) ([]string, func(),
+	trimmed := false
+	for i, arg := range args {
+		if arg == "-trimpath" && i+1 < len(args) {
+			args[i+1] += ";" + work + "=>/antithesis/" + pkg.ImportPath
+			trimmed = true
+			break
+		}
+	}
+	if !trimmed {
+		cleanup()
+		return nil, nil, fmt.Errorf("compile invocation for %s has no -trimpath", pkg.ImportPath)
+	}
@@ -151 +163,4 @@ func instrumentCoverage(cfg *Config, pkg *Package, args []string, paths []string
-	args = append(args, registration) // edit 2
+	firstSource := pkg.SourceStart
+	args = append(args, "")
+	copy(args[firstSource+1:], args[firstSource:])
