diff --git a/tools/antithesis-go-toolexec/runtime_edges_test.go b/tools/antithesis-go-toolexec/runtime_edges_test.go
index e66f580e..195396e3 100644
--- a/tools/antithesis-go-toolexec/runtime_edges_test.go
+++ b/tools/antithesis-go-toolexec/runtime_edges_test.go
@@ -109,0 +110,60 @@ func TestRuntimeEdgesToolexec(t *testing.T) {
+func TestPackageVariableCanCallInstrumentedCode(t *testing.T) {
+	dir := t.TempDir()
+	helperDir := filepath.Join(dir, "helper")
+	qt.Assert(t, qt.IsNil(os.Mkdir(helperDir, 0o755)))
+	qt.Assert(t, qt.IsNil(os.WriteFile(filepath.Join(helperDir, "go.mod"), []byte("module helper\n\ngo 1.24\n"), 0o644)))
+	helper := `package helper
+
+type Initializer interface {
+	Initialize()
+}
+
+func New(initializer Initializer) string {
+	initializer.Initialize()
+	return "initialized"
+}
+`
+	qt.Assert(t, qt.IsNil(os.WriteFile(filepath.Join(helperDir, "helper.go"), []byte(helper), 0o644)))
+	goMod := "module initedge\n\ngo 1.24\n\nrequire (\n\tgithub.com/antithesishq/antithesis-sdk-go v0.0.0\n\thelper v0.0.0\n)\n\n" +
+		"replace github.com/antithesishq/antithesis-sdk-go => " + sharedRecorder + "\n\n" +
+		"replace helper => " + helperDir + "\n"
+	qt.Assert(t, qt.IsNil(os.WriteFile(filepath.Join(dir, "go.mod"), []byte(goMod), 0o644)))
+	source := `package main
+
+import (
+	"fmt"
+	"helper"
+	"io"
+)
+
+type value struct{}
+
+func (*value) Initialize() {
+	fmt.Fprintln(io.Discard, "called")
+}
+
+var initialized = helper.New(&value{})
+
+func main() {
+	if initialized != "initialized" {
+		panic("package variable was not initialized")
+	}
+}
+`
+	qt.Assert(t, qt.IsNil(os.WriteFile(filepath.Join(dir, "program.go"), []byte(source), 0o644)))
+
+	symbolsDir := filepath.Join(dir, "symbols")
+	binary := filepath.Join(dir, "prog")
+	build := exec.Command("go", "build", "-toolexec="+sharedToolexec, "-o", binary, ".")
+	build.Dir = dir
+	build.Env = buildEnv(symbolsDir, "initedge", "ANTITHESIS_SKIP_CATALOG=1")
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("building the instrumented program failed: %v\n%s", err, out)
+	}
+	command := exec.Command(binary)
+	command.Dir = dir
+	if out, err := command.CombinedOutput(); err != nil {
+		t.Fatalf("running the instrumented program failed: %v\n%s", err, out)
+	}
+}
+
