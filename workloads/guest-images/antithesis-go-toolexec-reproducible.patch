diff --git a/tools/antithesis-go-toolexec/policy_test.go b/tools/antithesis-go-toolexec/policy_test.go
index bc3cc096..9d374ed6 100644
--- a/tools/antithesis-go-toolexec/policy_test.go
+++ b/tools/antithesis-go-toolexec/policy_test.go
@@ -6,0 +7 @@ import (
+	"github.com/antithesishq/antithesis-sdk-go/tools/antithesis-go-instrumentor/common"
@@ -63,0 +65,11 @@ func TestSkipFile(t *testing.T) {
+func TestSelectedPackagePreservesFirstSourceIndex(t *testing.T) {
+	common.NewLogWriter("", common.Normal)
+	t.Setenv("TOOLEXEC_IMPORTPATH", "example.com/app")
+	args := strings.Fields("-importcfg $W/importcfg -pack /src/api.pb.go /src/main.go")
+	pkg, selected := selectedPackage(&Config{Instrument: []string{"example.com/app"}}, args)
+	qt.Assert(t, qt.IsTrue(selected))
+	qt.Assert(t, qt.Equals(pkg.SourceStart, len(args)-2))
+	qt.Assert(t, qt.HasLen(pkg.GoFiles, 1))
+	qt.Assert(t, qt.Equals(pkg.GoFiles[0].Path, "/src/main.go"))
+}
