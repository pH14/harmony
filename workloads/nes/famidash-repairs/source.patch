--- /dev/null
+++ b/SAUCE/functions/base_crossing.h
@@ -0,0 +1,75 @@
+#define BASE_METADATA 1
+CODE_BANK_PUSH("CODE")
+static unsigned char ss_base_open, ss_base_axis, ss_base_remaining;
+extern const unsigned char metatiles_bases[128];
+static unsigned int ss_base_lhs, ss_base_rhs;
+CODE_BANK_POP()
+CODE_BANK_PUSH("XCD_BANK_03")
+
+unsigned char ss_base_clip(void) {
+    if (ss_x0 > (signed char)ss_abs_dx || ss_x1 < 0 || ss_y0 > (signed char)ss_abs_dy || ss_y1 < 0) return 0;
+    if ((ss_x0 == (signed char)ss_abs_dx && (ss_base_open & 1)) ||
+        (!ss_x1 && (ss_base_open & 2)) ||
+        (ss_y0 == (signed char)ss_abs_dy && (ss_base_open & 4)) ||
+        (!ss_y1 && (ss_base_open & 8))) return 0;
+    if (!ss_abs_dx || !ss_abs_dy) return 1;
+    if (ss_x0 >= 0 && ss_y1 <= (signed char)ss_abs_dy) {
+        ss_base_lhs = (unsigned int)(unsigned char)ss_x0 * ss_abs_dy;
+        ss_base_rhs = (unsigned int)(unsigned char)ss_y1 * ss_abs_dx;
+        if (ss_base_lhs > ss_base_rhs || (ss_base_lhs == ss_base_rhs && (ss_base_open & 9))) return 0;
+    }
+    if (ss_y0 >= 0 && ss_x1 <= (signed char)ss_abs_dx) {
+        ss_base_lhs = (unsigned int)(unsigned char)ss_y0 * ss_abs_dx;
+        ss_base_rhs = (unsigned int)(unsigned char)ss_x1 * ss_abs_dy;
+        if (ss_base_lhs > ss_base_rhs || (ss_base_lhs == ss_base_rhs && (ss_base_open & 6))) return 0;
+    }
+    return 1;
+}
+
+CODE_BANK_POP()
