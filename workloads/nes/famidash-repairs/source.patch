--- /dev/null
+++ b/SAUCE/functions/mini_wave22.h
@@ -0,0 +1,73 @@
+CODE_BANK_PUSH("MINI_WAVE22_BANK")
+static signed char m22_dx, m22_dy, m22_ox, m22_oy;
+static unsigned char m22_type;
+static const unsigned char m22_vertices[64] = {
+    0,0, 32,0, 32,16, 32,16,
+    0,0, 32,0, 32,32, 0,16,
+    0,32, 32,16, 32,32, 32,32,
+    0,16, 32,0, 32,32, 0,32,
+    0,0, 32,0, 32,16, 0,32,
+    0,0, 32,0, 0,16, 0,16,
+    0,0, 32,16, 32,32, 0,32,
+    0,16, 32,32, 0,32, 0,32,
+};
+
+int m22_signed_product(signed char x, signed char y) {
+    static unsigned char ax, ay;
+    static unsigned int product;
+    ax = x; ay = y;
+    product = (unsigned int)ax * ay;
+    if (x < 0) product -= (unsigned int)ay << 8;
+    if (y < 0) product -= (unsigned int)ax << 8;
+    return (signed short)product;
+}
+
+unsigned char mini22_polygon_hit(void) {
+    static unsigned char shape, index, count, lookup, positive, negative;
+    static signed char x, y;
+    static int limit, endpoint, side;
+    static const unsigned char limits[8] = {0,32,64,32,64,32,0,32};
+    static const unsigned char counts[8] = {3,4,3,4,4,3,4,3};
+    if (m22_ox > (m22_dx > 0 ? m22_dx : 0) || m22_ox + 32 < (m22_dx < 0 ? m22_dx : 0) ||
+        m22_oy > (m22_dy > 0 ? m22_dy : 0) || m22_oy + 32 < (m22_dy < 0 ? m22_dy : 0)) return 0;
+    switch (m22_type) {
+        case COL_SLOPE_RU22_RIGHT: shape = 0; break;
+        case COL_SLOPE_RU22_LEFT: shape = 1; break;
+        case COL_SLOPE_RD22_RIGHT: shape = 2; break;
+        case COL_SLOPE_RD22_LEFT: shape = 3; break;
+        case COL_SLOPE_LU22_RIGHT: shape = 4; break;
+        case COL_SLOPE_LU22_LEFT: shape = 5; break;
+        case COL_SLOPE_LD22_RIGHT: shape = 6; break;
+        case COL_SLOPE_LD22_LEFT: shape = 7; break;
+        default: return 0;
+    }
+    limit = m22_oy * 2 + limits[shape]; endpoint = m22_dy * 2;
+    if (shape < 2 || shape >= 6) { limit -= m22_ox; endpoint -= m22_dx; }
+    else { limit += m22_ox; endpoint += m22_dx; }
+    if ((shape >= 2 && shape < 4) || shape >= 6) {
+        if (limit > 0 && endpoint < limit) return 0;
+    } else if (limit < 0 && endpoint > limit) return 0;
+    positive = negative = 0; count = counts[shape];
+    for (index = 0; index < count; ++index) {
+        lookup = (unsigned char)(shape << 3) + (unsigned char)(index << 1);
+        x = m22_ox + m22_vertices[lookup];
+        ++lookup;
+        y = m22_oy + m22_vertices[lookup];
+        side = m22_signed_product(x, m22_dy);
+        side -= m22_signed_product(y, m22_dx);
+        if (!side) return 1;
+        if (side > 0) positive = 1;
+        else negative = 1;
+        if (positive && negative) return 1;
+    }
+    return 0;
+}
+
+void check_mini_wave22_tile(void) {
+    if (wrap_mode) return;
+    if ((ss_x & 240) == (ss_old_x & 240) && (ss_y & 240) == (ss_old_y & 240)) return;
+    m22_dx = ss_dx * 2; m22_dy = ss_dy * 2;
+    m22_type = ss_type; m22_ox = ss_origin_x * 2 - 1; m22_oy = ss_origin_y * 2 - 1;
+    if (mini22_polygon_hit()) cube_data[ss_player] |= 1;
+}
+CODE_BANK_POP()
