+    mw_dx = ss_dx; mw_dy = ss_dy;
+    mw_type = ss_type; mw_ox = ss_origin_x; mw_oy = ss_origin_y;
+    if (mini66_polygon_hit()) cube_data[ss_player] |= 1;
+}
