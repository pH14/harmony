{
  "version": 2,
  "setup": {
    "program": "/opt/harmony/network-init.sh",
    "directory": "/harmony"
  },
  "readiness": {
    "program": "/opt/harmony/fault-ready",
    "args": ["--primary", "10.0.0.1:7000", "--replica-socket", "/run/fault-replica.sock"],
    "directory": "/harmony"
  },
  "nodes": [
    {
      "id": 0,
      "name": "primary",
      "program": "/opt/harmony/netns-exec",
      "args": ["fault-primary", "/opt/harmony/fault-replica", "--role", "primary", "--listen", "10.0.0.1:7000", "--peer", "10.0.1.1:7000"],
      "directory": "/var/lib/fault-primary"
    },
    {
      "id": 1,
      "name": "replica",
      "program": "/opt/harmony/netns-exec",
      "args": ["fault-replica", "/opt/harmony/fault-replica", "--role", "replica", "--listen", "10.0.1.1:7000", "--control-socket", "/run/fault-replica.sock"],
      "directory": "/var/lib/fault-replica"
    }
  ],
  "network": [
    {"from": 0, "to": 1, "interface": "veth-0-1"}
  ],
  "check": {
    "program": "/opt/harmony/fault-check",
    "args": ["--primary", "10.0.0.1:7000", "--replica-socket", "/run/fault-replica.sock"],
    "directory": "/harmony"
  },
  "pending": {
    "program": "/opt/harmony/fault-pending",
    "args": ["--primary", "10.0.0.1:7000", "--replica-socket", "/run/fault-replica.sock"],
    "directory": "/harmony"
  },
  "recovery": {
    "program": "/opt/harmony/fault-recovery",
    "args": ["--primary", "10.0.0.1:7000", "--replica-socket", "/run/fault-replica.sock"],
    "directory": "/harmony"
  }
}
