setup /opt/harmony/setup.sh
node n1 /opt/harmony/node.sh n1 4001 4002
node n2 /opt/harmony/node.sh n2 4003 4004
node n3 /opt/harmony/node.sh n3 4005 4006
disk n1 /tmp/rqlite/n1 256M
disk n2 /tmp/rqlite/n2 256M
disk n3 /tmp/rqlite/n3 256M
log n1 /tmp/rqlite/n1.log
log n2 /tmp/rqlite/n2.log
log n3 /tmp/rqlite/n3.log
hook 1 /opt/harmony/harness-net partition
hook 2 /opt/harmony/harness-net isolate
hook 3 /opt/harmony/harness-net delay
hook 4 /opt/harmony/harness-net heal
heal 4
ready /usr/bin/env HARNESS_RQLITE_MODE=forward /opt/harmony/rqlite-harness ready
workload /usr/bin/env HARNESS_RQLITE_MODE=forward /opt/harmony/rqlite-harness drive
check /usr/bin/env HARNESS_RQLITE_MODE=forward /opt/harmony/rqlite-harness check
