+func (r *Raft) recordSnapshotInstall(id ServerID, term uint64) bool {
+	r.snapshotInstallsLock.Lock()
+	defer r.snapshotInstallsLock.Unlock()
+	if r.snapshotInstalls == nil {
+		r.snapshotInstalls = make(map[ServerID]uint64)
+	}
+	r.snapshotInstalls[id] = term
+	for other, t := range r.snapshotInstalls {
+		if other != id && t == term {
+			return true
+		}
+	}
+	return false
+}
+
+func (r *Raft) installedOnOtherPeer(id ServerID, term uint64) bool {
+	r.snapshotInstallsLock.Lock()
+	defer r.snapshotInstallsLock.Unlock()
+	for other, t := range r.snapshotInstalls {
+		if other != id && t == term {
+			return true
+		}
+	}
+	return false
 }
