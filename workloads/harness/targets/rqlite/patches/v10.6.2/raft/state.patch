@@ -0,0 +1,98 @@
+package raft
+
+import (
+	"math/bits"
+	"sync/atomic"
+
+	"github.com/antithesishq/antithesis-sdk-go/lifecycle"
+)
+
+var harmonyStateKeys = [8]string{
+	"role",
+	"uncommitted",
+	"apply lag",
+	"since snapshot",
+	"restored window",
+	"snapshots in flight",
+	"max lag",
+	"max next below first",
+}
+
+func (r *Raft) sendHarmonyState() {
+	var role uint64
+	switch r.getState() {
+	case Leader:
+		role = 1
+	case Candidate:
+		role = 2
+	}
+	lastIndex := r.getLastIndex()
+	lastApplied := r.getLastApplied()
+	commitIndex := max(r.getCommitIndex(), lastApplied)
+	snapshotIndex, _ := r.getLastSnapshot()
+	var restored uint64
+	if r.restoredLeaderSnapshot.Load() && snapshotIndex == r.restoredSnapshotIndex.Load() {
+		restored = 1
+	}
+	var inFlight, maxLag, maxBelowFirst uint64
+	if role == 1 {
+		if n := r.snapshotsInFlight.Load(); n > 0 {
+			inFlight = uint64(n)
+		}
+		var matches map[ServerID]uint64
+		if c := r.leaderState.commitment; c != nil {
+			c.Lock()
+			matches = make(map[ServerID]uint64, len(c.matchIndexes))
+			for id, match := range c.matchIndexes {
+				matches[id] = match
+			}
+			c.Unlock()
+		}
+		for id, s := range r.leaderState.replState {
+			match := matches[id]
+			if match == 0 {
+				match = harmonyGap(atomic.LoadUint64(&s.nextIndex), 1)
+			}
+			maxLag = max(maxLag, harmonyGap(lastIndex, match))
+		}
+		if firstIndex, err := r.logs.FirstIndex(); err == nil {
+			for _, s := range r.leaderState.replState {
+				maxBelowFirst = max(maxBelowFirst, harmonyGap(firstIndex, atomic.LoadUint64(&s.nextIndex)))
+			}
+		}
+	}
+	state := [8]uint64{
+		role,
+		harmonyGap(lastIndex, commitIndex),
+		harmonyGap(commitIndex, lastApplied),
+		harmonyGap(lastApplied, snapshotIndex),
+		restored,
+		inFlight,
+		maxLag,
+		maxBelowFirst,
+	}
+	if r.harmonyStateSent && harmonyBuckets(state) == harmonyBuckets(r.harmonyState) {
+		return
+	}
+	r.harmonyState = state
+	r.harmonyStateSent = true
+	details := make(map[string]any, len(state))
+	for i, v := range state {
+		details["raft "+string(r.localID)+" "+harmonyStateKeys[i]] = v
+	}
+	lifecycle.SendEvent("harmony_state", details)
+}
+
+func harmonyGap(a, b uint64) uint64 {
+	if a > b {
+		return a - b
+	}
+	return 0
+}
+
+func harmonyBuckets(state [8]uint64) (b [8]int) {
+	for i, v := range state {
+		b[i] = bits.Len64(v)
+	}
+	return b
+}
