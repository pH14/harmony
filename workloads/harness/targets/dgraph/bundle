setup /opt/harmony/setup.sh
node n1 /opt/harmony/node.sh 1
node n2 /opt/harmony/node.sh 2
node n3 /opt/harmony/node.sh 3
disk n1 /tmp/dgraph/n1 512M
disk n2 /tmp/dgraph/n2 512M
disk n3 /tmp/dgraph/n3 512M
log n1 /tmp/dgraph/n1.log
log n2 /tmp/dgraph/n2.log
log n3 /tmp/dgraph/n3.log
hook 1 /opt/harmony/harness-net partition
hook 2 /opt/harmony/harness-net isolate
hook 3 /opt/harmony/harness-net delay
hook 4 /opt/harmony/harness-net heal
heal 4
ready /opt/harmony/dgraph-harness ready --ready-timeout 30s
workload /opt/harmony/dgraph-harness drive --timeout 5s
check /opt/harmony/dgraph-harness check
