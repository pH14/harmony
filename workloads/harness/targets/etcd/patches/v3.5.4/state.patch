+func (r *raft) emitState() {
+	if r.stateKeys == nil {
+		p := fmt.Sprintf("raft %x ", r.id)
+		r.stateKeys = []string{p + "role", p + "uncommitted", p + "apply lag", p + "since snapshot", p + "restored window", p + "snapshots in flight", p + "max lag", p + "max next below first"}
+	}
+	first := r.raftLog.firstIndex()
+	last := r.raftLog.lastIndex()
+	var vals [8]int64
+	switch r.state {
+	case StateLeader:
+		vals[0] = 1
+	case StateCandidate:
+		vals[0] = 2
+	case StatePreCandidate:
+		vals[0] = 4
+	}
+	vals[1] = int64(last) - int64(r.raftLog.committed)
+	vals[2] = int64(r.raftLog.committed) - int64(r.raftLog.applied)
+	vals[3] = int64(r.raftLog.applied) - int64(first-1)
+	if s := r.restoredSnapshot; s > 0 && first == s+1 {
+		vals[4] = 1
+	}
+	if r.state == StateLeader {
+		r.prs.Visit(func(id uint64, pr *tracker.Progress) {
+			if id == r.id {
+				return
+			}
+			if pr.State == tracker.StateSnapshot {
+				vals[5]++
+			}
+			if lag := int64(last) - int64(pr.Match); lag > vals[6] {
+				vals[6] = lag
+			}
+			if below := int64(first) - int64(pr.Next); below > vals[7] {
+				vals[7] = below
+			}
+		})
+	}
+	var lens [8]int
+	for i, v := range vals {
+		if v > 0 {
+			lens[i] = bits.Len64(uint64(v))
+		}
+	}
+	if r.stateSent && lens == r.stateLens {
+		return
+	}
+	r.stateSent = true
+	r.stateLens = lens
+	details := make(map[string]any, len(vals))
+	for i, v := range vals {
+		details[r.stateKeys[i]] = v
+	}
+	lifecycle.SendEvent("harmony_state", details)
+}
