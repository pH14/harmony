#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Fast local feedback before GitHub-hosted CI does the full pass.
# Installed by scripts/install-quality-tools.sh via `git config core.hooksPath
# .githooks`. This is a convenience, NOT the check of record (that is the
# GitHub-hosted runner / .github/workflows/quality.yml) — it runs the *fast*
# cross-platform checks so a developer gets early signal:
#
#   fmt -> clippy (-D warnings) -> nextest -> this machine's hypervisor tests
#
# Miri is deliberately NOT here: it runs only in CI (the nightly.yml miri
# jobs) — interpreting the unsafe crates costs ~10 minutes locally, which
# defeats a fast-feedback hook. The unsafe⇒Miri review-bar rule (AGENTS.md)
# still applies to PRs whose diff touches `unsafe`.
#
# Skip in a pinch with `git push --no-verify`.
set -euo pipefail

echo "== pre-push: stripping disallowed comments"
python3 scripts/strip-comments.py
if ! git diff --quiet; then
    echo "   comments were stripped — staging the changes"
    git add -u
fi

echo "== pre-push: cargo fmt --check"
cargo fmt --all -- --check

echo "== pre-push: cargo clippy -D warnings"
cargo clippy --all-features --all-targets -- -D warnings

echo "== pre-push: cargo nextest"
if command -v cargo-nextest >/dev/null 2>&1; then
    cargo nextest run --all-features
else
    echo "   (cargo-nextest not installed; falling back to cargo test)"
    cargo test --all-features
fi

# Hosted runners have no hypervisor for some architectures, so the ignored
# tests that need one run here on a machine that has it. HOST_TESTS in
# scripts/ci_contract.py lists them per machine.
echo "== pre-push: this machine's hypervisor tests"
filter=$(python3 scripts/ci_contract.py host-filter)
if [ -z "$filter" ]; then
    echo "   (no hypervisor tests are registered for this machine)"
elif command -v cargo-nextest >/dev/null 2>&1; then
    cargo nextest run --all-features --run-ignored only -E "$filter"
else
    echo "   cargo-nextest is required to run this machine's hypervisor tests: cargo install cargo-nextest" >&2
    exit 1
fi

echo "== pre-push: all fast checks passed"
