{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "name",
    "rust_source",
    "scope_to_lineage",
    "rationale",
    "strategy_journal"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["install_detector", "install_mutator", "install_ranking", "none"]
    },
    "name": { "type": "string" },
    "rust_source": { "type": "string" },
    "scope_to_lineage": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "rationale": { "type": "string" },
    "strategy_journal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beliefs", "failed_approaches", "open_questions", "current_plan"],
      "properties": {
        "beliefs": { "type": "array", "items": { "type": "string" } },
        "failed_approaches": { "type": "array", "items": { "type": "string" } },
        "open_questions": { "type": "array", "items": { "type": "string" } },
        "current_plan": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
