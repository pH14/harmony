{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "name",
    "rust_source",
    "scope_to_lineage",
    "rationale"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["install_detector", "install_mutator", "none"]
    },
    "name": { "type": "string" },
    "rust_source": { "type": "string" },
    "scope_to_lineage": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "rationale": { "type": "string" }
  }
}
