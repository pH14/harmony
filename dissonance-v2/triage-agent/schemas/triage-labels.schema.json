{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interest",
    "duplicate_of",
    "flags",
    "tags",
    "summary",
    "hypotheses"
  ],
  "properties": {
    "interest": {
      "type": "string",
      "enum": ["Boost", "Neutral", "Suppress"]
    },
    "duplicate_of": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["BugSuspect", "InvariantNearMiss", "DeadEnd"]
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": "string" },
    "hypotheses": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
